@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin SpringFlower</title>

    <!-- Nhúng Bootstrap, FontAwesome và Google Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --sf-cream: #FCFAF5;
            --sf-sage: #7E9D68;
            --sf-sage-dark: #5F7D4B;
            --sf-sage-light: #EEF3EA;
            --sf-text: #2C3329;
            --sf-muted: #788273;
            --sf-border: #EAE6DC;
        }

        /* ============ 1. CÀI ĐẶT CHUNG ============ */
        body {
            background-color: var(--sf-cream);
            font-family: 'Inter', sans-serif;
            color: var(--sf-text);
            margin: 0;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Inter', sans-serif;
            color: var(--sf-text);
            letter-spacing: -0.01em;
        }

        /* ============ 2. SIDEBAR BÊN TRÁI ============ */
        .sidebar {
            width: 260px;
            height: 100vh;
            background-color: #ffffff;
            position: fixed;
            top: 0;
            left: 0;
            border-right: 1px solid var(--sf-border);
            padding-top: 18px;
            overflow-y: auto;
            z-index: 1000;
        }

            /* Logo */
            .sidebar .logo {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                padding: 8px 20px 24px 20px;
                text-decoration: none;
                border-bottom: 1px dashed var(--sf-border);
                margin: 0 16px 10px 16px;
            }

            .sidebar .logo-text {
                font-family: 'Playfair Display', serif;
                font-weight: 700;
                color: var(--sf-sage-dark);
                font-size: 21px;
                letter-spacing: 0.3px;
            }

            /* Tiêu đề nhóm menu */
            .sidebar .menu-category {
                font-size: 11px;
                font-weight: 700;
                color: #9AA395;
                text-transform: uppercase;
                letter-spacing: 1.2px;
                padding: 16px 22px 6px 22px;
            }

            /* Các mục trong menu */
            .sidebar .menu-item {
                display: flex;
                align-items: center;
                padding: 11px 16px;
                color: #4F584B;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s ease;
                margin: 3px 14px;
                border-radius: 10px;
            }

                .sidebar .menu-item i {
                    width: 24px;
                    font-size: 15px;
                    color: #7D8778;
                    transition: all 0.2s ease;
                }

                .sidebar .menu-item:hover {
                    background-color: var(--sf-sage-light);
                    color: var(--sf-sage-dark);
                }

                    .sidebar .menu-item:hover i {
                        color: var(--sf-sage-dark);
                    }

                /* Menu đang được chọn */
                .sidebar .menu-item.active {
                    background: linear-gradient(135deg, var(--sf-sage) 0%, var(--sf-sage-dark) 100%);
                    color: #fff;
                    box-shadow: 0 4px 12px rgba(126, 157, 104, 0.28);
                }

                    .sidebar .menu-item.active i {
                        color: #fff;
                    }

            /* Nút đăng xuất */
            .sidebar .logout {
                color: #C85A53;
                margin-top: 16px;
            }

                .sidebar .logout i {
                    color: #C85A53;
                }

                .sidebar .logout:hover {
                    background-color: #FDF2F2;
                    color: #B0413A;
                }

        /* ============ 3. NỘI DUNG BÊN PHẢI ============ */
        .main-content {
            margin-left: 260px;
            width: calc(100% - 260px);
            min-height: 100vh;
        }

        /* Thanh Header */
        .top-header {
            background-color: rgba(252, 250, 245, 0.85);
            backdrop-filter: blur(8px);
            height: 72px;
            padding: 0 36px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--sf-border);
            position: sticky;
            top: 0;
            z-index: 900;
        }

            .top-header .page-title {
                font-size: 22px;
                font-weight: 700;
                margin: 0;
                color: var(--sf-text);
            }

        .btn-view-web {
            border: 1px solid var(--sf-sage);
            color: var(--sf-sage-dark);
            background-color: #fff;
            border-radius: 8px;
            padding: 6px 14px;
            font-weight: 500;
            font-size: 13px;
            transition: all 0.2s;
        }

            .btn-view-web:hover {
                background-color: var(--sf-sage);
                color: #fff;
            }

        .admin-info {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 14px;
            color: var(--sf-text);
        }

        .admin-avatar {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, var(--sf-sage) 0%, var(--sf-sage-dark) 100%);
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 15px;
            box-shadow: 0 2px 8px rgba(126, 157, 104, 0.3);
        }

        /* Vùng nội dung */
        .content-body {
            padding: 32px 36px;
        }

        /* CSS cơ bản cho thẻ Card ở các trang con */
        .card {
            border: 1px solid var(--sf-border);
            border-radius: 14px;
            background: #fff;
            box-shadow: 0 2px 12px rgba(44, 51, 41, 0.03);
        }

        .card-header {
            background: #fff;
            border-bottom: 1px solid var(--sf-border);
            font-weight: 600;
            border-top-left-radius: 14px !important;
            border-top-right-radius: 14px !important;
        }
    </style>
</head>
<body>

    <!-- ============ SIDEBAR BÊN TRÁI ============ -->
    <div class="sidebar">
        <!-- Logo -->
        <a href="@Url.Action("Dashboard", "Admin")" class="logo">
            <img src="@Url.Content("~/Content/images/anh logo thmx.png")" alt="SpringFlower" style="max-height: 40px; width: auto; object-fit: contain;" />
            <span class="logo-text">SpringFlower</span>
        </a>

        <!-- NHÓM 1: TỔNG QUAN -->
        <div class="menu-category">Tổng quan</div>
        <a href="@Url.Action("Dashboard", "Admin")" class="menu-item @(ViewBag.Title == "Dashboard" ? "active" : "")">
            <i class="fa-solid fa-chart-pie me-2"></i> Dashboard
        </a>

        <!-- NHÓM 2: QUẢN LÝ -->
        <div class="menu-category">Quản lý</div>
        <a href="@Url.Action("ProductManager", "Admin")" class="menu-item @(ViewBag.Title == "Quản lý sản phẩm" ? "active" : "")">
            <i class="fa-solid fa-box me-2"></i> Quản lý sản phẩm
        </a>
        <a href="@Url.Action("OrderManager", "Admin")" class="menu-item @(ViewBag.Title == "Quản lý đơn hàng" ? "active" : "")">
            <i class="fa-solid fa-receipt me-2"></i> Quản lý đơn hàng
        </a>
        <a href="@Url.Action("CategoryManager", "Admin")" class="menu-item @(ViewBag.Title == "Quản lý danh mục" ? "active" : "")">
            <i class="fa-solid fa-tags me-2"></i> Quản lý danh mục
        </a>
        <a href="@Url.Action("UserManager", "Admin")" class="menu-item @(ViewBag.Title == "Quản lý người dùng" ? "active" : "")">
            <i class="fa-solid fa-users me-2"></i> Quản lý người dùng
        </a>
        <a href="@Url.Action("CouponManager", "Admin")" class="menu-item @(ViewBag.Title == "Quản lý Voucher" ? "active" : "")">
            <i class="fa-solid fa-ticket me-2"></i> Quản lý Voucher
        </a>
        <a href="@Url.Action("MessageManager", "Admin")" class="menu-item @(ViewBag.Title == "Tin nhắn liên hệ" ? "active" : "")">
            <i class="fa-solid fa-envelope me-2"></i> Tin nhắn liên hệ
        </a>

        <!-- NHÓM 3: HỆ THỐNG -->
        <div class="menu-category">Hệ thống</div>
        <a href="@Url.Action("BankConfig", "Admin")" class="menu-item @(ViewBag.Title == "Cấu hình Cổng thanh toán" || ViewBag.Title == "Cấu hình ngân hàng" ? "active" : "")">
            <i class="fa-solid fa-building-columns me-2"></i> Cấu hình ngân hàng
        </a>

        <a href="@Url.Action("Logout", "Account")" class="menu-item logout">
            <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
        </a>
    </div>

    <!-- ============ NỘI DUNG BÊN PHẢI ============ -->
    <div class="main-content">

        <!-- Thanh Header -->
        <div class="top-header">
            <h1 class="page-title">@ViewBag.Title</h1>

            <div class="admin-info">
                <a href="@Url.Action("Index", "Home")" target="_blank" class="btn btn-view-web me-2">
                    <i class="fa-solid fa-globe me-1"></i> Xem Website
                </a>
                <span>Chào, <b>Quản trị viên</b></span>
                <div class="admin-avatar">A</div>
            </div>
        </div>

        <!-- Vùng nội dung -->
        <div class="content-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success border-0 rounded-3" style="background-color: #EEF3EA; color: #3E5630;">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 rounded-3">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>