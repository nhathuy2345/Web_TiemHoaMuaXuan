@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin TiemHoaMuaXuan</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Hiệu ứng active menu */
        .menu-item.active {
            background-color: #7f1d1d;
            color: #fb7185;
            font-weight: 600;
        }

        /* Scrollbar đẹp hơn */
        aside::-webkit-scrollbar {
            width: 4px;
        }

        aside::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 2px;
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body class="bg-gray-100">

    <div class="flex min-h-screen">

        <!-- ===== SIDEBAR ADMIN ===== -->
        <aside class="w-64 bg-gray-900 text-white flex-shrink-0 flex flex-col">

            <!-- Logo -->
            <div class="p-5 text-xl font-bold border-b border-gray-800 flex items-center gap-2">
                <i class="fa-solid fa-leaf text-rose-500"></i>
                <span>Spring Flower</span>
            </div>

            <!-- Menu -->
            <nav class="p-4 space-y-1 text-gray-300 flex-1 overflow-y-auto">
                @{
                    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

                    Func<string, string> activeClass = (action) =>
                        currentAction.Equals(action, System.StringComparison.OrdinalIgnoreCase)
                            ? "menu-item active"
                            : "";
                }

                <!-- Dashboard -->
                <a href="@Url.Action("Dashboard", "Admin")"
                   class="menu-item flex items-center gap-3 p-2.5 rounded-lg hover:bg-gray-800 hover:text-rose-400 transition @activeClass("Dashboard")">
                    <i class="fa-solid fa-chart-line w-5"></i>
                    <span>Dashboard</span>
                </a>

                <!-- Quản lý sản phẩm -->
                <a href="@Url.Action("ProductManager", "Admin")"
                   class="menu-item flex items-center gap-3 p-2.5 rounded-lg hover:bg-gray-800 hover:text-rose-400 transition @activeClass("ProductManager")">
                    <i class="fa-solid fa-box w-5"></i>
                    <span>Quản lý sản phẩm</span>
                </a>

                <!-- Thêm sản phẩm (sub) -->
                @if (currentAction == "CreateProduct" || currentAction == "EditProduct")
                {
                    <a href="@Url.Action("CreateProduct", "Admin")"
                       class="menu-item active flex items-center gap-3 p-2 rounded-lg ml-6 text-sm">
                        <i class="fa-solid fa-circle text-[6px]"></i>
                        <span>@(currentAction == "EditProduct" ? "Sửa sản phẩm" : "Thêm sản phẩm")</span>
                    </a>
                }

                <!-- Quản lý đơn hàng -->
                <a href="@Url.Action("OrderManager", "Admin")"
                   class="menu-item flex items-center gap-3 p-2.5 rounded-lg hover:bg-gray-800 hover:text-rose-400 transition @activeClass("OrderManager")">
                    <i class="fa-solid fa-receipt w-5"></i>
                    <span>Quản lý đơn hàng</span>
                </a>

                <!-- ===== TIN NHẮN LIÊN HỆ (THÊM MỚI) ===== -->
                @{
                    int unreadCount = 0;
                    try
                    {
                        var contactService = new Web_TiemHoaMuaXuan.Services.ContactService();
                        unreadCount = contactService.CountUnread();
                    }
                    catch { unreadCount = 0; }
                }
                <a href="@Url.Action("MessageManager", "Admin")"
                   class="menu-item flex items-center gap-3 p-2.5 rounded-lg hover:bg-gray-800 hover:text-rose-400 transition @activeClass("MessageManager")">
                    <i class="fa-solid fa-envelope w-5"></i>
                    <span>Tin nhắn liên hệ</span>
                    @if (unreadCount > 0)
                    {
                        <span class="ml-auto bg-red-500 text-white text-xs px-2 py-0.5 rounded-full font-bold">
                            @unreadCount
                        </span>
                    }
                </a>

                <!-- ===== CẤU HÌNH NGÂN HÀNG (đã có) ===== -->
                <a href="@Url.Action("BankConfig", "Admin")"
                   class="menu-item flex items-center gap-3 p-2.5 rounded-lg hover:bg-gray-800 hover:text-rose-400 transition @activeClass("BankConfig")">
                    <i class="fa-solid fa-building-columns w-5"></i>
                    <span>Cấu hình ngân hàng</span>
                </a>

                <!-- Divider -->
                <hr class="border-gray-800 my-3" />

                <!-- Về trang chủ -->
                <a href="@Url.Action("Index", "Home")"
                   class="flex items-center gap-3 p-2.5 rounded-lg hover:bg-gray-800 hover:text-rose-400 transition">
                    <i class="fa-solid fa-arrow-left w-5"></i>
                    <span>Về trang chủ</span>
                </a>
            </nav>

            <!-- Logout footer -->
            <div class="p-4 border-t border-gray-800">
                <a href="@Url.Action("Logout", "Account")"
                   class="flex items-center justify-center gap-2 w-full p-2.5 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white transition text-sm font-medium">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Đăng xuất</span>
                </a>
            </div>
        </aside>

        <!-- ===== MAIN CONTENT ===== -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- TOP HEADER -->
            <header class="bg-white shadow-sm px-6 py-3 flex justify-between items-center sticky top-0 z-40">
                <h1 class="font-bold text-lg text-gray-800">@ViewBag.Title</h1>

                <div class="flex items-center gap-4">
                    <!-- Avatar admin -->
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-rose-500 text-white flex items-center justify-center font-bold text-sm">
                            A
                        </div>
                        <div class="hidden md:block text-sm">
                            <div class="font-semibold text-gray-800">Admin</div>
                            <div class="text-xs text-gray-500">Quản trị viên</div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- BODY -->
            <main class="p-6 flex-1">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="bg-white border-t px-6 py-3 text-center text-xs text-gray-500">
                &copy; 2026 TiemHoaMuaXuan - Được thiết kế bởi Team. All Rights Reserved.
            </footer>
        </div>
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>