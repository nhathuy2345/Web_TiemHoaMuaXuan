@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin Spring Flower</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body class="bg-gray-100">

    <div class="flex min-h-screen">

        <!-- ===== SIDEBAR ADMIN ===== -->
        <aside class="w-64 bg-gray-900 text-white flex-shrink-0">
            <div class="p-5 text-xl font-bold border-b border-gray-800 flex items-center gap-2">
                <i class="fa-solid fa-leaf text-rose-500"></i>
                <span>Spring Flower</span>
            </div>

            <nav class="p-4 space-y-2 text-gray-300">
                <a href="@Url.Action("Dashboard", "Admin")"
                   class="flex items-center gap-3 p-2 rounded hover:bg-gray-800 hover:text-rose-400 transition">
                    <i class="fa-solid fa-chart-line w-5"></i>
                    <span>Dashboard</span>
                </a>

                <a href="@Url.Action("ProductManager", "Admin")"
                   class="flex items-center gap-3 p-2 rounded hover:bg-gray-800 hover:text-rose-400 transition">
                    <i class="fa-solid fa-box w-5"></i>
                    <span>Quản lý sản phẩm</span>
                </a>

                <a href="@Url.Action("OrderManager", "Admin")"
                   class="flex items-center gap-3 p-2 rounded hover:bg-gray-800 hover:text-rose-400 transition">
                    <i class="fa-solid fa-receipt w-5"></i>
                    <span>Quản lý đơn hàng</span>
                </a>

                <hr class="border-gray-800 my-3" />

                <a href="@Url.Action("Index", "Home")"
                   class="flex items-center gap-3 p-2 rounded hover:bg-gray-800 hover:text-rose-400 transition">
                    <i class="fa-solid fa-arrow-left w-5"></i>
                    <span>Về trang chủ</span>
                </a>

                <a href="@Url.Action("Logout", "Account")"
                   class="flex items-center gap-3 p-2 rounded hover:bg-gray-800 hover:text-rose-400 transition text-red-400">
                    <i class="fa-solid fa-right-from-bracket w-5"></i>
                    <span>Đăng xuất</span>
                </a>
            </nav>
        </aside>

        <!-- ===== MAIN CONTENT ===== -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- TOP HEADER -->
            <header class="bg-white shadow-sm p-4 flex justify-between items-center">
                <h1 class="font-bold text-lg text-gray-800">@ViewBag.Title</h1>

                <div class="flex items-center gap-4 text-sm">
                    <span class="text-gray-600">
                        <i class="fa-solid fa-user-circle text-rose-500 mr-1"></i>
                        Xin chào, <b>Admin</b>
                    </span>
                </div>
            </header>

            <!-- BODY -->
            <main class="p-6 flex-1">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="bg-white border-t px-6 py-3 text-center text-xs text-gray-500">
                &copy; 2026 Spring Flower Admin Panel - Đồ án Web_TiemHoaMuaXuan
            </footer>
        </div>
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>