@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - SpringFlower</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* --- TONE XANH LÁ TỰ NHIÊN --- */
        body {
            background-color: #FCFAF5 !important; /* Nền kem sữa */
            color: #4A3424 !important; /* Chữ nâu đậm */
            font-family: 'Quicksand', sans-serif !important;
        }

        .text-dark, h1, h2, h3, h4, h5, h6 {
            color: #4A3424 !important;
        }

        /* Đổi màu nút & khối sang Xanh lá */
        .bg-success, .btn-success {
            background-color: #7E9D68 !important;
            border-color: #7E9D68 !important;
            color: white !important;
        }

        .text-success {
            color: #7E9D68 !important;
        }

        .btn-outline-success {
            color: #7E9D68 !important;
            border-color: #7E9D68 !important;
        }

            .btn-outline-success:hover {
                background-color: #7E9D68 !important;
                color: white !important;
            }

        .btn-success:hover {
            background-color: #6A8756 !important;
        }

        .border-success {
            border-color: #7E9D68 !important;
        }

        .sidebar-title {
            background-color: #7E9D68 !important;
        }

        /* Nền các khung phụ */
        .bg-light {
            background-color: #F2EBE1 !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    @Html.Partial("_Topbar")
    @Html.Partial("_Header") <!-- ĐÂY LÀ HEADER -->

    <div class="container flex-grow-1 mb-5">

        <!-- ⭐ KHU VỰC HIỂN THỊ THÔNG BÁO LỖI/THÀNH CÔNG ⭐ -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3">
                <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3">
                <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <!-- ⭐ KẾT THÚC KHU VỰC THÔNG BÁO ⭐ -->

        <div class="row">
            <!-- Cột Trái: Sidebar (Danh mục) -->
            <div class="col-lg-3 d-none d-lg-block">
                @Html.Partial("_Sidebar")
            </div>

            <!-- Cột Phải: Nội dung chính -->
            <div class="col-lg-9">
                @RenderBody()
            </div>
        </div>
    </div>

    @Html.Partial("_Footer")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Khung chat nổi -->
    @Html.Partial("_ChatWidget")

    <!-- ⭐ BẮT BUỘC PHẢI ĐẶT Ở ĐÂY ĐỂ CÁC TRANG CON CHÈN JAVASCRIPT (VD: MÃ QR) ⭐ -->
    @RenderSection("scripts", required: false)

</body>
</html>