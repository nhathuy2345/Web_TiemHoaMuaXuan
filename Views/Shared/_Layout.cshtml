@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Tiệm Hoa Mùa Xuân</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        #container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        #main-wrapper {
            display: flex;
            flex: 1;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            padding: 30px 20px;
            gap: 30px;
        }

        #sidebar {
            width: 260px;
            flex-shrink: 0;
        }

        #content {
            flex: 1;
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body class="bg-rose-50 text-gray-800">
    <div id="container">
        @Html.Partial("_Header")
        <div id="main-wrapper">
            @if (IsSectionDefined("Sidebar"))
            {
                @RenderSection("Sidebar")
            }
            else
            {
                @Html.Partial("_Sidebar")
            }
            <main id="content">
                @RenderBody()
            </main>
        </div>
        @Html.Partial("_Footer")
    </div>
    @RenderSection("scripts", required: false)
    @* === TOAST THÔNG BÁO === *@
    @if (TempData["Success"] != null)
    {
        <div id="toast-success" class="fixed top-5 right-5 z-[9999] transform translate-x-full transition-transform duration-500">
            <div class="flex items-center gap-3 bg-green-500 text-white px-5 py-4 rounded-xl shadow-2xl min-w-[300px]">
                <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-check text-lg"></i>
                </div>
                <div class="flex-1">
                    <div class="font-bold">Thành công!</div>
                    <div class="text-sm text-green-50">@TempData["Success"]</div>
                </div>
                <button onclick="closeToast()" class="text-white/70 hover:text-white transition">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>

        <script>
            function closeToast() {
                var toast = document.getElementById('toast-success');
                if (toast) {
                    toast.classList.add('translate-x-full');
                    setTimeout(function () { toast.remove(); }, 500);
                }
            }

            // Hiện toast khi trang load xong
            window.addEventListener('DOMContentLoaded', function () {
                var toast = document.getElementById('toast-success');
                if (toast) {
                    setTimeout(function () { toast.classList.remove('translate-x-full'); }, 100);

                    // Auto ẩn sau 4 giây
                    setTimeout(function () { closeToast(); }, 4000);
                }
            });
        </script>
    }
</body>
</html>