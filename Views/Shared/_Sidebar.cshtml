@{
    var productService = new Web_TiemHoaMuaXuan.Services.ProductService();
    var categories = productService.GetCategories();
    var currentCatId = ViewBag.CurrentCategoryId as int?;
}
<div class="mb-4 shadow-sm">
    <div class="sidebar-title text-uppercase">
        <i class="fa-solid fa-bars me-2"></i> Danh mục
    </div>
    <div class="bg-white border border-top-0 rounded-bottom">
        <ul class="list-group list-group-flush">
            <li class="list-group-item">
                <a href="@Url.Action("Index","Product")" class="text-decoration-none text-dark d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-success">Tất cả sản phẩm</span>
                </a>
            </li>
            @foreach (var c in categories)
            {
                var isActive = currentCatId == c.Id;
                <li class="list-group-item">
                    <a href="@Url.Action("Index","Product", new { categoryId = c.Id })"
                       class="text-decoration-none d-flex justify-content-between align-items-center @(isActive ? "text-success fw-bold" : "text-dark")">
                        <span><i class="fa-solid fa-caret-right text-success me-2"></i>@c.Name</span>
                    </a>
                </li>
            }
        </ul>
    </div>
</div>