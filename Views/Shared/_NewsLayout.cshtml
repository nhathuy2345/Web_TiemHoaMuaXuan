@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - SpringFlower</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Quicksand', sans-serif;
            background-color: #FCFAF5;
            color: #4A3424;
            overflow-x: hidden;
        }

        .font-serif {
            font-family: 'Playfair Display', serif;
        }

        /* Thanh cuộn mảnh */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #FCFAF5;
        }

        ::-webkit-scrollbar-thumb {
            background: #7E9D68;
            border-radius: 4px;
        }

        /* Header trong suốt */
        .header-transparent {
            position: fixed; /* Đổi thành fixed để luôn nằm trên */
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 20px 0;
            transition: all 0.4s ease;
        }

            .header-transparent a {
                color: white;
                text-decoration: none;
                font-weight: 500;
                font-size: 0.95rem;
                margin: 0 15px;
                transition: 0.3s;
            }

                .header-transparent a:hover, .header-transparent a.active-nav {
                    color: #7E9D68;
                }

        /* Khi cuộn chuột (Thêm class qua JS) */
        .header-scrolled {
            background: rgba(252, 250, 245, 0.9);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            padding: 10px 0;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }

            .header-scrolled a {
                color: #4A3424; /* Đổi chữ thành màu nâu đậm */
            }

                .header-scrolled a:hover, .header-scrolled a.active-nav {
                    color: #7E9D68;
                }

            .header-scrolled .btn-outline-light {
                border-color: #7E9D68;
                color: #7E9D68;
            }

            .header-scrolled .text-white {
                color: #4A3424 !important;
            }
    </style>
</head>
<body>

    <!-- Header -->
    <header class="header-transparent" id="mainHeader">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="@Url.Action("Index","Home")" class="d-flex align-items-center gap-2">
                <img src="~/Content/images/anh logo thmx.png" alt="Logo" style="height: 50px;" onerror="this.src='https://via.placeholder.com/50x50?text=Logo'">
                <span class="fs-4 font-serif fw-bold text-white transition-colors">SpringFlower</span>
            </a>

            <nav class="d-none d-md-flex">
                <a href="@Url.Action("Index","Home")">TRANG CHỦ</a>
                <a href="@Url.Action("About","Home")">GIỚI THIỆU</a>
                <a href="@Url.Action("News","Home")" class="active-nav">TIN NỔI BẬT</a>
                <a href="@Url.Action("Index","Product")">SẢN PHẨM</a>
            </nav>

            <div>
                <a href="@Url.Action("Login","Account")" class="btn btn-outline-light rounded-pill btn-sm px-4 fw-bold">Đăng nhập</a>
            </div>
        </div>
    </header>

    @RenderBody()

    <footer class="bg-dark text-white text-center py-4 mt-5" style="background-color: #2c3e2e !important;">
        <p class="mb-0 text-white-50 small">&copy; @DateTime.Now.Year Tiệm Hoa Mùa Xuân. Dự án môn Nhập môn lập trình Web.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        // Khởi tạo AOS
        AOS.init({ duration: 800, once: true, offset: 50 });

        // Hiệu ứng đổi màu Header khi cuộn
        window.addEventListener('scroll', function () {
            const header = document.getElementById('mainHeader');
            if (window.scrollY > 50) {
                header.classList.add('header-scrolled');
            } else {
                header.classList.remove('header-scrolled');
            }
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>