@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - SpringFlower</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Quicksand', sans-serif;
        }

        .navbar-custom {
            padding: 15px 0;
            border-bottom: 1px solid #eee;
        }

        .nav-link {
            color: #333;
            font-weight: 500;
            text-transform: uppercase;
            font-size: 0.9rem;
            margin: 0 10px;
        }

            .nav-link:hover {
                color: #198754;
            }
    </style>
</head>
<body>

    <!-- Header Đơn giản (Không có Topbar, không có Search) -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white navbar-custom sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3 text-success" href="@Url.Action("Index","Home")">
                <img src="~/Content/images/anh logo thmx.png" alt="Logo" style="height: 50px;"> SpringFlower
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuAbout">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="menuAbout">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Home")">Trang Chủ</a></li>
                    <li class="nav-item"><a class="nav-link active text-success" href="@Url.Action("About","Home")">Giới Thiệu</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Product")">Sản Phẩm</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Contact")">Liên Hệ</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Nội dung trang -->
    @RenderBody()

    <!-- Footer đơn giản -->
    <footer class="bg-dark text-white text-center py-4 mt-5">
        <p class="mb-0">&copy; @DateTime.Now.Year Tiệm Hoa Mùa Xuân. Đồ Án Môn Lập Trình Web Nhóm 10</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 1000, // Thời gian chạy hiệu ứng (1 giây)
            once: true      // Chỉ chạy 1 lần khi cuộn xuống
        });
    </script>
</body>
</html>