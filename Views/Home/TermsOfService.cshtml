@{
    ViewBag.Title = "Điều Khoản Sử Dụng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header -->
            <div class="text-center mb-5 p-4 rounded shadow-sm" style="background: linear-gradient(135deg, #a8d5a8, #7ebc7e); color: white;">
                <h1 class="fw-bold"> Điều Khoản Sử Dụng</h1>
                <p class="mb-0">Tiệm Hoa Mùa Xuân - Minh bạch & Rõ ràng trong mọi giao dịch</p>
            </div>

            <!-- Nội dung -->
            <div class="bg-white p-4 p-md-5 rounded shadow-sm">
                <div class="alert alert-success bg-opacity-10" style="background-color: #f0faf0; border-left: 4px solid #7ebc7e; color: #333;">
                    Vui lòng đọc kỹ các điều khoản dưới đây trước khi đặt hoa. Việc bạn sử dụng website đồng nghĩa với việc bạn đã đồng ý với toàn bộ nội dung.
                </div>

                <h4 class="mt-4 text-success fw-bold">1. Điều Kiện Đặt Hàng</h4>
                <ul>
                    <li>Cung cấp thông tin chính xác: họ tên, SĐT, địa chỉ giao hoa</li>
                    <li>Người đặt hàng từ 18 tuổi trở lên</li>
                    <li>Đơn hàng chỉ xác nhận khi tiệm liên hệ thành công</li>
                </ul>

                <h4 class="mt-4 text-success fw-bold">2. Giá Cả & Thanh Toán</h4>
                <ul>
                    <li>Giá đã bao gồm VAT, chưa gồm phí vận chuyển (trừ khi ghi chú)</li>
                    <li>Thanh toán: COD, chuyển khoản, ví điện tử</li>
                    <li>Đơn lớn/giao tỉnh cần đặt cọc trước 30-50%</li>
                </ul>

                <h4 class="mt-4 text-success fw-bold">3. Giao Hàng</h4>
                <ul>
                    <li>Nội thành: 2-4 giờ (đặt trước ít nhất 3 giờ)</li>
                    <li>Ngoại thành & tỉnh: 24-48 giờ</li>
                    <li>Không chịu trách nhiệm nếu khách cung cấp sai địa chỉ</li>
                </ul>

                <h4 class="mt-4 text-success fw-bold">4. Chính Sách Đổi Trả</h4>
                <ul>
                    <li><strong>Hoa hư hỏng do vận chuyển:</strong> đổi mới hoặc hoàn tiền 100%</li>
                    <li><strong>Giao sai mẫu/số lượng:</strong> đổi đúng mẫu hoặc hoàn tiền</li>
                    <li><strong>Khách đổi ý:</strong> hủy trước 3 giờ được hoàn 50% cọc</li>
                    <li>Cần hình ảnh/video trong 2 giờ sau khi nhận hoa</li>
                </ul>

                <h4 class="mt-4 text-success fw-bold">5. Giải Quyết Tranh Chấp</h4>
                <p>Tranh chấp được ưu tiên giải quyết qua thương lượng. Nếu không đạt thỏa thuận, đưa ra cơ quan chức năng có thẩm quyền tại TP.HCM.</p>

                <h4 class="mt-4 text-success fw-bold">6. Liên Hệ</h4>
                <ul>
                    <li> 123 Đường Hoa Xuân, Quận 1, TP.HCM</li>
                    <li> Hotline: 0123 456 789</li>
                    <li> cskh@tiemhoamuaxuan.vn</li>
                </ul>

                <div class="text-center mt-5 pt-3 border-top">
                    <p class="text-muted small">Cập nhật lần cuối: 26/10/2025</p>
                </div>
            </div>
        </div>
    </div>
</div>