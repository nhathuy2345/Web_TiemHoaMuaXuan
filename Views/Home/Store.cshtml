@{
    Layout = null;
    ViewBag.Title = "Hệ thống cửa hàng";
    var currentUser = Session["User"] as Web_TiemHoaMuaXuan.Models.Entities.AppUser;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SpringFlower</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --sf-dark: #2c3e2e;
            --sf-green: #7E9D68;
            --sf-green-dark: #5F7D4B;
            --sf-cream: #FCFAF5;
            --sf-sand: #F2EBE1;
            --sf-text: #4A3424;
        }

        body {
            background-color: var(--sf-cream);
            color: var(--sf-text);
            font-family: 'Quicksand', sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6, .font-serif {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
        }

        /* ================= HEADER ================= */
        .store-navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1030;
            padding: 16px 0;
            transition: all 0.35s ease;
        }

            .store-navbar .navbar-brand {
                color: #fff;
                font-family: 'Playfair Display', serif;
                font-weight: 700;
                font-size: 1.45rem;
                display: inline-flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .store-navbar .nav-link {
                color: rgba(255, 255, 255, 0.9) !important;
                font-weight: 600;
                font-size: 0.9rem;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                margin: 0 10px;
                transition: color 0.25s;
            }

                .store-navbar .nav-link:hover,
                .store-navbar .nav-link.active {
                    color: #d9ead3 !important;
                }

            .store-navbar .btn-account {
                border: 1px solid rgba(255, 255, 255, 0.75);
                color: #fff;
                border-radius: 999px;
                padding: 7px 20px;
                font-weight: 600;
                font-size: 0.9rem;
                text-decoration: none;
                transition: all 0.25s;
            }

                .store-navbar .btn-account:hover {
                    background: #fff;
                    color: var(--sf-dark);
                }

            .store-navbar.scrolled {
                background: rgba(252, 250, 245, 0.92);
                backdrop-filter: blur(14px);
                -webkit-backdrop-filter: blur(14px);
                padding: 10px 0;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            }

                .store-navbar.scrolled .navbar-brand {
                    color: var(--sf-dark);
                }

                .store-navbar.scrolled .nav-link {
                    color: var(--sf-text) !important;
                }

                    .store-navbar.scrolled .nav-link:hover,
                    .store-navbar.scrolled .nav-link.active {
                        color: var(--sf-green) !important;
                    }

                .store-navbar.scrolled .btn-account {
                    border-color: var(--sf-green);
                    color: var(--sf-green-dark);
                }

                    .store-navbar.scrolled .btn-account:hover {
                        background: var(--sf-green);
                        color: #fff;
                    }

        /* ================= HERO BANNER ================= */
        .hero-section {
            position: relative;
            min-height: 430px;
            padding: 120px 0 70px;
            background: linear-gradient(135deg, rgba(44, 62, 46, 0.82), rgba(74, 52, 36, 0.72)),
                        url('https://images.unsplash.com/photo-1487530811176-3780de880c2d?q=80&w=1600') center/cover no-repeat;
            display: flex;
            align-items: center;
            text-align: center;
            color: #fff;
        }

        .hero-title {
            font-size: clamp(2.1rem, 4.5vw, 3.6rem);
            color: #fff;
            text-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
        }

        .hero-stat-pill {
            background: rgba(255, 255, 255, 0.14);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 999px;
            padding: 8px 18px;
            font-size: 0.9rem;
            color: #fff;
        }

        /* ================= THẺ CHI NHÁNH & BẢN ĐỒ ================= */
        .store-card {
            background: #fff;
            border-radius: 16px;
            padding: 22px;
            border: 2px solid transparent;
            box-shadow: 0 4px 16px rgba(44, 62, 46, 0.05);
            transition: all 0.25s ease;
            cursor: pointer;
        }

            .store-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 24px rgba(44, 62, 46, 0.1);
                border-color: rgba(126, 157, 104, 0.4);
            }

            .store-card.active-store {
                border-color: var(--sf-green);
                background: #f8fbf6;
                box-shadow: 0 10px 26px rgba(126, 157, 104, 0.16);
            }

        .map-wrapper {
            border-radius: 18px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 10px 30px rgba(44, 62, 46, 0.08);
            border: 1px solid rgba(0, 0, 0, 0.06);
        }

        .btn-green {
            background-color: var(--sf-green);
            border-color: var(--sf-green);
            color: #fff;
            border-radius: 999px;
            font-weight: 600;
            transition: all 0.25s;
        }

            .btn-green:hover {
                background-color: var(--sf-green-dark);
                border-color: var(--sf-green-dark);
                color: #fff;
            }

        .btn-outline-green {
            border: 1px solid var(--sf-green);
            color: var(--sf-green-dark);
            border-radius: 999px;
            font-weight: 600;
            transition: all 0.25s;
        }

            .btn-outline-green:hover {
                background-color: var(--sf-green);
                color: #fff;
            }

        /* ================= FOOTER ================= */
        .store-footer {
            background: var(--sf-dark);
            color: #d4ddc9;
            padding: 56px 0 0;
        }

            .store-footer h6 {
                color: #fff;
                font-size: 1.15rem;
                margin-bottom: 16px;
            }

            .store-footer a {
                color: #d4ddc9;
                text-decoration: none;
                transition: color 0.25s;
            }

                .store-footer a:hover {
                    color: var(--sf-green);
                }

            .store-footer ul {
                list-style: none;
                padding: 0;
            }

                .store-footer ul li {
                    margin-bottom: 9px;
                    font-size: 0.93rem;
                }

            .store-footer .footer-bottom {
                border-top: 1px solid rgba(255, 255, 255, 0.1);
                padding: 18px 0;
                margin-top: 36px;
                text-align: center;
                font-size: 0.88rem;
                color: #9eaa93;
            }
    </style>
</head>
<body>

    <!-- ==================== HEADER ==================== -->
    <nav class="navbar navbar-expand-lg store-navbar" id="storeNav">
        <div class="container">
            <a href="@Url.Action("Index", "Home")" class="navbar-brand">
                <img src="~/Content/images/anh logo thmx.png" alt="Logo Tiệm Hoa" style="height: 40px; object-fit: contain;" />
                <span>SpringFlower</span>
            </a>

            <button class="navbar-toggler border-0 bg-white bg-opacity-75" type="button" data-bs-toggle="collapse" data-bs-target="#storeMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="storeMenu">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a href="@Url.Action("Index", "Home")" class="nav-link">Trang chủ</a></li>
                    <li class="nav-item"><a href="@Url.Action("About", "Home")" class="nav-link">Giới thiệu</a></li>
                    <li class="nav-item"><a href="@Url.Action("News", "Home")" class="nav-link">Tin nổi bật</a></li>
                    <li class="nav-item"><a href="@Url.Action("Store", "Home")" class="nav-link active">Cửa hàng</a></li>
                    <li class="nav-item"><a href="@Url.Action("Index", "Product")" class="nav-link">Sản phẩm</a></li>
                </ul>

                <div class="d-flex align-items-center mt-2 mt-lg-0">
                    @if (currentUser != null)
                    {
                        <div class="dropdown">
                            <a class="btn-account dropdown-toggle d-inline-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-user-circle"></i> @currentUser.FullName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Profile", "Account")">
                                        <i class="fa-solid fa-id-card text-muted me-2"></i>Thông tin tài khoản
                                    </a>
                                </li>
                                @if (currentUser.IsAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item fw-bold text-danger" href="@Url.Action("Dashboard", "Admin")">
                                            Trang Quản Trị
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")">
                                        <i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")" class="btn-account">Đăng nhập</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- ==================== HERO BANNER ==================== -->
    <section class="hero-section">
        <div class="container" data-aos="fade-up">
            <span class="badge px-3 py-2 rounded-pill mb-3 text-uppercase" style="background-color: var(--sf-green); letter-spacing: 1.5px;">
                Hệ thống cửa hàng
            </span>
            <h1 class="hero-title fw-bold mb-3">Tìm Cửa Hàng Gần Bạn</h1>
            <p class="fs-5 opacity-90 mb-4 mx-auto" style="max-width: 620px;">
                Ghé thăm không gian hoa tươi SpringFlower để chọn hoa trực tiếp và nhận tư vấn thiết kế theo yêu cầu.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <span class="hero-stat-pill"><i class="fa-solid fa-store me-2 text-warning"></i>3 Chi nhánh tại TP.HCM</span>
                <span class="hero-stat-pill"><i class="fa-regular fa-clock me-2 text-warning"></i>Mở cửa 08:00 – 22:00</span>
                <span class="hero-stat-pill"><i class="fa-solid fa-truck-fast me-2 text-warning"></i>Giao nhanh nội thành 2h</span>
            </div>
        </div>
    </section>

    <!-- ==================== BẢN ĐỒ & DANH SÁCH CHI NHÁNH ==================== -->
    <section class="container py-5">
        <div class="row g-4 align-items-start">
            <!-- Cột Trái: Tìm kiếm & Danh sách chi nhánh -->
            <div class="col-lg-5" data-aos="fade-right">
                <div class="mb-3">
                    <h3 class="fw-bold mb-1">Chi Nhánh SpringFlower</h3>
                    <p class="text-muted small mb-3">Chọn một cửa hàng để xem vị trí trực tiếp trên bản đồ.</p>
                    <div class="input-group shadow-sm rounded-pill overflow-hidden bg-white border">
                        <span class="input-group-text bg-white border-0 ps-3 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="storeSearch" class="form-control border-0 shadow-none"
                               placeholder="Tìm theo quận hoặc tên đường..." oninput="filterStores()">
                    </div>
                </div>

                <div class="d-flex flex-column gap-3" id="storeList">
                    <!-- Chi nhánh 1 -->
                    <div class="store-card active-store"
                         data-name="Quận 1 (Trụ sở chính)"
                         data-address="123 Nguyễn Huệ, P. Bến Nghé, Quận 1, TP.HCM"
                         data-query="123 Nguyen Hue, Ben Nghe, Quan 1, Ho Chi Minh"
                         onclick="selectStore(this)">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0"><i class="fa-solid fa-store text-success me-2"></i>Quận 1 (Trụ sở chính)</h5>
                            <span class="badge bg-success-subtle text-success rounded-pill">Đang mở</span>
                        </div>
                        <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot text-success me-2"></i>123 Nguyễn Huệ, P. Bến Nghé, Quận 1, TP.HCM</p>
                        <div class="d-flex flex-wrap gap-3 text-muted small mb-3">
                            <span><i class="fa-solid fa-phone text-success me-1"></i> 028 1234 5678</span>
                            <span><i class="fa-regular fa-clock text-success me-1"></i> 08:00 – 22:00</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-green btn-sm px-3 flex-grow-1" onclick="event.stopPropagation(); selectStore(this.closest('.store-card'))">
                                <i class="fa-solid fa-map-pin me-1"></i> Xem bản đồ
                            </button>
                            <a href="https://maps.google.com/?q=123+Nguyen+Hue+Quan+1+TPHCM" target="_blank" onclick="event.stopPropagation()" class="btn btn-outline-green btn-sm px-3">
                                <i class="fa-solid fa-diamond-turn-right me-1"></i> Chỉ đường
                            </a>
                        </div>
                    </div>

                    <!-- Chi nhánh 2 -->
                    <div class="store-card"
                         data-name="Chi nhánh Quận 3"
                         data-address="456 Võ Văn Tần, P. 5, Quận 3, TP.HCM"
                         data-query="456 Vo Van Tan, Phuong 5, Quan 3, Ho Chi Minh"
                         onclick="selectStore(this)">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0"><i class="fa-solid fa-store text-success me-2"></i>Chi nhánh Quận 3</h5>
                            <span class="badge bg-success-subtle text-success rounded-pill">Đang mở</span>
                        </div>
                        <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot text-success me-2"></i>456 Võ Văn Tần, P. 5, Quận 3, TP.HCM</p>
                        <div class="d-flex flex-wrap gap-3 text-muted small mb-3">
                            <span><i class="fa-solid fa-phone text-success me-1"></i> 028 8765 4321</span>
                            <span><i class="fa-regular fa-clock text-success me-1"></i> 08:00 – 21:30</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-green btn-sm px-3 flex-grow-1" onclick="event.stopPropagation(); selectStore(this.closest('.store-card'))">
                                <i class="fa-solid fa-map-pin me-1"></i> Xem bản đồ
                            </button>
                            <a href="https://maps.google.com/?q=456+Vo+Van+Tan+Quan+3+TPHCM" target="_blank" onclick="event.stopPropagation()" class="btn btn-outline-green btn-sm px-3">
                                <i class="fa-solid fa-diamond-turn-right me-1"></i> Chỉ đường
                            </a>
                        </div>
                    </div>

                    <!-- Chi nhánh 3 -->
                    <div class="store-card"
                         data-name="Chi nhánh Quận 7"
                         data-address="789 Nguyễn Thị Thập, P. Bình Thuận, Quận 7, TP.HCM"
                         data-query="789 Nguyen Thi Thap, Binh Thuan, Quan 7, Ho Chi Minh"
                         onclick="selectStore(this)">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0"><i class="fa-solid fa-store text-success me-2"></i>Chi nhánh Quận 7</h5>
                            <span class="badge bg-success-subtle text-success rounded-pill">Đang mở</span>
                        </div>
                        <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot text-success me-2"></i>789 Nguyễn Thị Thập, P. Bình Thuận, Quận 7, TP.HCM</p>
                        <div class="d-flex flex-wrap gap-3 text-muted small mb-3">
                            <span><i class="fa-solid fa-phone text-success me-1"></i> 028 1357 2468</span>
                            <span><i class="fa-regular fa-clock text-success me-1"></i> 08:30 – 21:00</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-green btn-sm px-3 flex-grow-1" onclick="event.stopPropagation(); selectStore(this.closest('.store-card'))">
                                <i class="fa-solid fa-map-pin me-1"></i> Xem bản đồ
                            </button>
                            <a href="https://maps.google.com/?q=789+Nguyen+Thi+Thap+Quan+7+TPHCM" target="_blank" onclick="event.stopPropagation()" class="btn btn-outline-green btn-sm px-3">
                                <i class="fa-solid fa-diamond-turn-right me-1"></i> Chỉ đường
                            </a>
                        </div>
                    </div>
                </div>

                <div id="noStoreFound" class="text-center py-4 text-muted small d-none">
                    Không tìm thấy chi nhánh phù hợp với từ khóa.
                </div>
            </div>

            <!-- Cột Phải: Bản đồ tương tác -->
            <div class="col-lg-7" data-aos="fade-left">
                <div class="map-wrapper position-sticky" style="top: 90px;">
                    <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <div class="fw-bold text-success" id="mapStoreTitle">
                                <i class="fa-solid fa-location-dot me-1"></i> Quận 1 (Trụ sở chính)
                            </div>
                            <small class="text-muted" id="mapStoreAddress">123 Nguyễn Huệ, P. Bến Nghé, Quận 1, TP.HCM</small>
                        </div>
                        <a id="mapExternalLink" href="https://maps.google.com/?q=123+Nguyen+Hue+Quan+1+TPHCM" target="_blank" class="btn btn-sm btn-outline-green px-3">
                            Mở Google Maps <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                        </a>
                    </div>
                    <iframe id="storeMapFrame"
                            src="https://maps.google.com/maps?q=123%20Nguyen%20Hue%2C%20Ben%20Nghe%2C%20Quan%201%2C%20Ho%20Chi%20Minh&t=&z=15&ie=UTF8&iwloc=&output=embed"
                            width="100%" height="500" style="border:0; display:block;" allowfullscreen="" loading="lazy"></iframe>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== TIỆN ÍCH TẠI CỬA HÀNG ==================== -->
    <section class="py-5" style="background-color: var(--sf-sand);">
        <div class="container">
            <div class="row g-4 text-center">
                <div class="col-md-4" data-aos="fade-up">
                    <div class="bg-white rounded-4 p-4 h-100 shadow-sm">
                        <i class="fa-solid fa-wand-magic-sparkles fs-2 text-success mb-3"></i>
                        <h5 class="fw-bold">Thiết kế theo yêu cầu</h5>
                        <p class="text-muted small mb-0">Chọn hoa trực tiếp tại quầy và nhận tư vấn phối màu từ đội ngũ florist.</p>
                    </div>
                </div>
                <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="bg-white rounded-4 p-4 h-100 shadow-sm">
                        <i class="fa-solid fa-truck-fast fs-2 text-success mb-3"></i>
                        <h5 class="fw-bold">Giao nhanh từ chi nhánh gần nhất</h5>
                        <p class="text-muted small mb-0">Tối ưu thời gian giao hàng trong vòng 2 giờ giúp hoa luôn giữ độ tươi.</p>
                    </div>
                </div>
                <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="bg-white rounded-4 p-4 h-100 shadow-sm">
                        <i class="fa-solid fa-gift fs-2 text-success mb-3"></i>
                        <h5 class="fw-bold">Miễn phí thiệp &amp; gói quà</h5>
                        <p class="text-muted small mb-0">Mỗi đơn hàng tại cửa hàng đều được tặng kèm thiệp chúc mừng trang nhã.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== FOOTER ==================== -->
    <footer class="store-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h6><i class="fa-solid fa-spa me-2 text-success"></i>Tiệm Hoa Mùa Xuân</h6>
                    <p class="small" style="line-height: 1.8; opacity: 0.85;">
                        Website kinh doanh hoa tươi, cung cấp đa dạng mẫu hoa đẹp và ý nghĩa cho mọi dịp đặc biệt.
                    </p>
                </div>
                <div class="col-md-4">
                    <h6>Liên kết nhanh</h6>
                    <ul>
                        <li><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                        <li><a href="@Url.Action("Index", "Product")">Sản phẩm</a></li>
                        <li><a href="@Url.Action("News", "Home")">Tin nổi bật</a></li>
                        <li><a href="@Url.Action("Index", "Cart")">Giỏ hàng</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6>Liên hệ</h6>
                    <ul>
                        <li><i class="fa-solid fa-location-dot me-2 text-success"></i>123 Nguyễn Huệ, Quận 1, TP.HCM</li>
                        <li><i class="fa-solid fa-phone me-2 text-success"></i>028 1234 5678</li>
                        <li><i class="fa-solid fa-envelope me-2 text-success"></i>hello@tiemhoamuaxuan.vn</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; @DateTime.Now.Year Tiệm Hoa Mùa Xuân. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 800, once: true, offset: 80 });

        window.addEventListener('scroll', function () {
            var nav = document.getElementById('storeNav');
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        function selectStore(card) {
            if (!card) return;
            document.querySelectorAll('.store-card').forEach(function (el) {
                el.classList.remove('active-store');
            });
            card.classList.add('active-store');

            var name = card.getAttribute('data-name');
            var address = card.getAttribute('data-address');
            var query = card.getAttribute('data-query');

            document.getElementById('mapStoreTitle').innerHTML = '<i class="fa-solid fa-location-dot me-1"></i> ' + name;
            document.getElementById('mapStoreAddress').innerText = address;
            document.getElementById('storeMapFrame').src = 'https://maps.google.com/maps?q=' + encodeURIComponent(query) + '&t=&z=15&ie=UTF8&iwloc=&output=embed';
            document.getElementById('mapExternalLink').href = 'https://maps.google.com/?q=' + encodeURIComponent(query);
        }

        function filterStores() {
            var keyword = (document.getElementById('storeSearch').value || '').trim().toLowerCase();
            var cards = document.querySelectorAll('#storeList .store-card');
            var count = 0;

            cards.forEach(function (card) {
                var text = (card.innerText || '').toLowerCase();
                if (!keyword || text.includes(keyword)) {
                    card.classList.remove('d-none');
                    count++;
                } else {
                    card.classList.add('d-none');
                }
            });

            document.getElementById('noStoreFound').classList.toggle('d-none', count > 0);
        }
    </script>
</body>
</html>
