@model List<Web_TiemHoaMuaXuan.Models.Entities.Product>
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- KHỐI BANNER & CAM KẾT -->
<div class="row mb-5 g-4">
    <!-- Banner Lớn -->
    <div class="col-lg-8" data-aos="fade-right">
        <div class="card border-0 overflow-hidden h-100 text-white shadow-lg rounded-4 position-relative"
             style="background: linear-gradient(rgba(44, 62, 46, 0.7), rgba(44, 62, 46, 0.7)), url('https://images.unsplash.com/photo-1563241527-3004b7be0ffd?q=80&w=1000') center/cover; min-height: 350px;">
            <div class="card-body d-flex flex-column justify-content-center p-5 position-relative z-2">
                <span class="badge bg-success mb-3 px-3 py-2 align-self-start fs-6 rounded-pill">Bộ sưu tập mới</span>
                <h1 class="display-5 fw-bold mb-3 text-white">Trao gửi yêu thương</h1>
                <p class="fs-5 mb-4 opacity-75">Giảm ngay 20% cho các mẫu thiết kế giỏ hoa mùa xuân rực rỡ.</p>
                <div>
                    <a href="@Url.Action("Index","Product")" class="btn btn-warning text-dark fw-bold px-4 py-2 rounded-pill shadow-sm">
                        Khám Phá Ngay <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 Ô Cam kết -->
    <div class="col-lg-4" data-aos="fade-left">
        <div class="row row-cols-2 g-3 h-100">
            <div class="col">
                <div class="card h-100 d-flex flex-column align-items-center justify-content-center text-center p-3 border-0 shadow-sm rounded-4 bg-white hover-elevate">
                    <div class="icon-circle bg-light rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="fa-solid fa-truck-fast fs-3 text-success"></i>
                    </div>
                    <div class="fw-bold text-dark fs-6">Giao nhanh</div>
                    <small class="text-muted">Nội thành 2H</small>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 d-flex flex-column align-items-center justify-content-center text-center p-3 border-0 shadow-sm rounded-4 bg-white hover-elevate">
                    <div class="icon-circle bg-light rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="fa-solid fa-shield-heart fs-3 text-success"></i>
                    </div>
                    <div class="fw-bold text-dark fs-6">Cam kết</div>
                    <small class="text-muted">Hoa tươi 100%</small>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 d-flex flex-column align-items-center justify-content-center text-center p-3 border-0 shadow-sm rounded-4 bg-white hover-elevate">
                    <div class="icon-circle bg-light rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="fa-solid fa-medal fs-3 text-success"></i>
                    </div>
                    <div class="fw-bold text-dark fs-6">Đảm bảo</div>
                    <small class="text-muted">Sạch, mới</small>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 d-flex flex-column align-items-center justify-content-center text-center p-3 border-0 shadow-sm rounded-4 bg-white hover-elevate">
                    <div class="icon-circle bg-light rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="fa-solid fa-leaf fs-3 text-success"></i>
                    </div>
                    <div class="fw-bold text-dark fs-6">Thân thiện</div>
                    <small class="text-muted">Môi trường</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- TIÊU ĐỀ SẢN PHẨM -->
<div class="d-flex justify-content-between align-items-end mb-4 mt-5 border-bottom pb-3" data-aos="fade-up">
    <div>
        <h3 class="fw-bold text-dark mb-1">Sản Phẩm Nổi Bật</h3>
        <p class="text-muted mb-0 small">Những bó hoa tuyệt đẹp nhất dành cho bạn</p>
    </div>
    <a href="@Url.Action("Index","Product")" class="text-decoration-none text-success fw-bold">
        Xem tất cả <i class="fa-solid fa-arrow-right ms-1"></i>
    </a>
</div>

<!-- LƯỚI SẢN PHẨM -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
    @foreach (var p in Model)
    {
        <div class="col" data-aos="fade-up" data-aos-delay="@(Model.IndexOf(p) * 100 % 300)">
            <div class="card product-card h-100">
                <div class="product-img-wrapper">
                    <a href="@Url.Action("Details","Product", new { id = p.Id })">
                        <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name" onerror="this.src='https://via.placeholder.com/300x250?text=Image+Not+Found'">
                        @if (p.DiscountPercent > 0)
                        {
                            <span class="position-absolute top-0 end-0 bg-danger text-white small px-2 py-1 m-3 rounded-pill fw-bold shadow-sm">
                                -@p.DiscountPercent%
                            </span>
                        }
                    </a>
                </div>

                <div class="card-body text-center d-flex flex-column p-4">
                    <h6 class="fw-bold text-truncate mb-2" title="@p.Name">
                        <a href="@Url.Action("Details","Product", new { id = p.Id })" class="text-decoration-none text-dark">@p.Name</a>
                    </h6>

                    <div class="mb-3 mt-auto">
                        <span class="text-danger fw-bold fs-5">@p.Price.ToString("N0")đ</span>
                        @if (p.OldPrice.HasValue && p.OldPrice > p.Price)
                        {
                            <small class="text-muted text-decoration-line-through ms-2">@p.OldPrice.Value.ToString("N0")đ</small>
                        }
                    </div>

                    <!-- Nút thêm vào giỏ hàng trượt lên -->
                    <div class="add-to-cart-btn">
                        <a href="@Url.Action("AddToCart","Cart", new { id = p.Id })" class="btn btn-success btn-sm w-100 rounded-pill">
                            <i class="fa-solid fa-cart-plus me-1"></i> Thêm vào giỏ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>