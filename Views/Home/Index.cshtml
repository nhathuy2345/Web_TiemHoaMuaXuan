@model List<Web_TiemHoaMuaXuan.Models.Entities.Product>
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Khối Banner và Cam kết -->
<div class="row mb-4 g-3">
    <!-- Banner Lớn (Dùng màu nền Gradient thay vì ảnh để không bị lỗi) -->
    <div class="col-md-8">
        <div class="card border-0 overflow-hidden h-100 text-white shadow-sm"
             style="background: linear-gradient(135deg, #9CB584 0%, #7E9D68 100%); min-height: 320px;">
            <div class="card-body d-flex flex-column justify-content-center p-5 position-relative">
                <h1 class="display-5 fw-bold mb-3 position-relative" style="z-index: 2;">Trao gửi yêu thương</h1>
                <p class="fs-5 mb-4 opacity-75 position-relative" style="z-index: 2;">Giảm ngay 20% cho các mẫu thiết kế giỏ hoa mới nhất.</p>
                <div class="position-relative" style="z-index: 2;">
                    <a href="@Url.Action("Index","Product")" class="btn btn-warning text-dark fw-bold px-4 py-2">
                        Khám Phá Ngay <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>
                </div>
                <!-- Icon trang trí mờ phía sau -->
                <i class="fa-solid fa-leaf position-absolute opacity-25" style="font-size: 18rem; right: -30px; bottom: -80px; z-index: 1;"></i>
            </div>
        </div>
    </div>

    <!-- 4 Ô Cam kết -->
    <div class="col-md-4">
        <div class="row row-cols-2 g-3 h-100">
            <div class="col">
                <div class="card h-100 d-flex align-items-center justify-content-center text-center p-3 border-warning border-2 shadow-sm">
                    <i class="fa-solid fa-truck-fast fs-1 text-success mb-2"></i>
                    <div class="fw-bold text-success">Giao nhanh</div>
                    <small class="text-muted">Nội thành</small>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 d-flex align-items-center justify-content-center text-center p-3 border-warning border-2 shadow-sm">
                    <i class="fa-solid fa-shield-heart fs-1 text-success mb-2"></i>
                    <div class="fw-bold text-success">Cam kết</div>
                    <small class="text-muted">Hoa tươi 100%</small>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 d-flex align-items-center justify-content-center text-center p-3 border-warning border-2 shadow-sm">
                    <i class="fa-solid fa-medal fs-1 text-success mb-2"></i>
                    <div class="fw-bold text-success">Đảm bảo</div>
                    <small class="text-muted">Sạch, mới</small>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 d-flex align-items-center justify-content-center text-center p-3 border-warning border-2 shadow-sm">
                    <i class="fa-solid fa-leaf fs-1 text-success mb-2"></i>
                    <div class="fw-bold text-success">Thân thiện</div>
                    <small class="text-muted">Môi trường</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tiêu đề Sản phẩm -->
<div class="d-flex justify-content-between align-items-center mb-3 mt-5 border-bottom pb-2">
    <h4 class="fw-bold text-success text-uppercase mb-0">Sản Phẩm Nổi Bật</h4>
    <a href="@Url.Action("Index","Product")" class="text-decoration-none text-success fw-bold small">
        Xem tất cả <i class="fa-solid fa-arrow-right"></i>
    </a>
</div>

<!-- Lưới Sản phẩm (3 cột) -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="card h-100 border-0 shadow-sm">
                <a href="@Url.Action("Details","Product", new { id = p.Id })" class="position-relative">
                    <img src="@p.ImageUrl" class="card-img-top product-img" alt="@p.Name" style="height: 220px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/300x220?text=Image+Not+Found'">
                    @if (p.DiscountPercent > 0)
                    {
                        <span class="position-absolute top-0 end-0 bg-danger text-white small px-2 py-1 m-2 rounded-circle fw-bold">
                            -@p.DiscountPercent%
                        </span>
                    }
                </a>
                <div class="card-body text-center d-flex flex-column">
                    <h6 class="fw-bold text-truncate mb-1" title="@p.Name">
                        <a href="@Url.Action("Details","Product", new { id = p.Id })" class="text-decoration-none text-dark">@p.Name</a>
                    </h6>
                    <p class="text-danger fw-bold fs-5 mb-2 mt-auto">@p.Price.ToString("N0")đ</p>
                    @if (p.OldPrice.HasValue && p.OldPrice > p.Price)
                    {
                        <small class="text-muted text-decoration-line-through d-block mb-2">@p.OldPrice.Value.ToString("N0")đ</small>
                    }
                    <a href="@Url.Action("AddToCart","Cart", new { id = p.Id })" class="btn btn-outline-success btn-sm w-100 mt-2">
                        <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ
                    </a>
                </div>
            </div>
        </div>
    }
</div>