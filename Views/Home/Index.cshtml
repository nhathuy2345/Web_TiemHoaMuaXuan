@model List<Web_TiemHoaMuaXuan.Models.Product>
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-gradient-to-r from-rose-200 to-pink-100 rounded-2xl p-8 mb-8 flex items-center justify-between shadow-sm relative overflow-hidden">
    <div class="relative z-10">
        <span class="bg-rose-500 text-white text-xs font-bold px-2 py-1 rounded mb-3 inline-block">ƯU ĐÃI MÙA XUÂN</span>
        <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Trao gửi yêu thương</h1>
        <p class="text-gray-700 mb-5 font-medium">Giảm ngay 20% cho các mẫu thiết kế giỏ hoa mới nhất.</p>
        <a href="@Url.Action("Index","Product")" class="bg-gray-900 text-white font-medium px-6 py-2.5 rounded hover:bg-rose-600 inline-block">Khám Phá Ngay</a>
    </div>
    <i class="fa-solid fa-fan text-8xl text-rose-300 opacity-40 absolute -right-4 -bottom-4 animate-pulse"></i>
</div>

<div class="flex justify-between items-end mb-6">
    <h2 class="text-2xl font-bold text-gray-800">Sản Phẩm Nổi Bật</h2>
    <a href="@Url.Action("Index","Product")" class="text-sm font-medium text-rose-500 hover:underline">
        Xem tất cả <i class="fa-solid fa-arrow-right ml-1"></i>
    </a>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    @foreach (var p in Model)
    {
        <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition overflow-hidden group">
            <a href="@Url.Action("Details","Product", new { id = p.Id })" class="block">
                <div class="h-56 bg-gray-50 overflow-hidden relative">
                    <img src="@p.ImageUrl" alt="@p.Name" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                    @if (p.DiscountPercent > 0)
                    {
                        <span class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded">-@p.DiscountPercent%</span>
                    }
                </div>
            </a>
            <div class="p-5">
                <h3 class="font-bold text-gray-800 mb-1 text-lg truncate">
                    <a href="@Url.Action("Details","Product", new { id = p.Id })" class="hover:text-rose-500">@p.Name</a>
                </h3>
                <div class="flex justify-between items-center mt-3">
                    <div>
                        <span class="text-rose-600 font-bold text-lg">@p.Price.ToString("N0")đ</span>
                        @if (p.OldPrice.HasValue && p.OldPrice > p.Price)
                        {
                            <span class="text-gray-400 line-through text-sm ml-1">@p.OldPrice.Value.ToString("N0")đ</span>
                        }
                    </div>
                    <a href="@Url.Action("AddToCart","Cart", new { id = p.Id })" class="w-10 h-10 rounded-full bg-gray-50 text-gray-600 hover:bg-rose-500 hover:text-white flex items-center justify-center">
                        <i class="fa-solid fa-cart-plus"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>