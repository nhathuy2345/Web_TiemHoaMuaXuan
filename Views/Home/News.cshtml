        var activeCategory = 'Tất cả';

        function filterNews(category, element) {
            activeCategory = category;
            if (element) {
                document.querySelectorAll('.sidebar-list .list-group-item').forEach(el => el.classList.remove('active-cat'));
                element.classList.add('active-cat');
            }
            applyNewsFilter();
        }

        function quickSearch(keyword) {
            document.getElementById('newsSearchInput').value = keyword;
            applyNewsFilter();
        }

        function applyNewsFilter() {
            var keyword = (document.getElementById('newsSearchInput').value || '').trim().toLowerCase();
            var items = document.querySelectorAll('.news-item');
            var visibleCount = 0;

            items.forEach(function (item) {
                var cat = item.getAttribute('data-category') || '';
                var text = (item.innerText || '').toLowerCase();
                var matchCat = (activeCategory === 'Tất cả' || cat === activeCategory);
                var matchKey = (!keyword || text.includes(keyword));

                if (matchCat && matchKey) {
                    item.classList.remove('d-none');
                    visibleCount++;
                } else {
                    item.classList.add('d-none');
                }
            });

            document.getElementById('articleCountLabel').innerText = 'Hiển thị ' + visibleCount + ' bài viết';
            document.getElementById('emptyFilterState').classList.toggle('d-none', visibleCount > 0);
        }

        function openArticle(index) {
            var art = articles[index];
            if (!art) return;
            document.getElementById('modalCategory').innerText = art.category;
            document.getElementById('modalTitle').innerText = art.title;
            document.getElementById('modalMeta').innerText = art.meta;
            document.getElementById('modalImage').src = art.image;
            document.getElementById('modalBody').innerHTML = art.body;
            var modal = new bootstrap.Modal(document.getElementById('articleModal'));
            modal.show();
        }

        const bg = document.getElementById('heroBackground');
        setInterval(() => {
            bg.classList.toggle('zoomed');
        }, 10000);

        const arrow = document.getElementById('scrollArrow');
        setInterval(() => {
            arrow.classList.toggle('bounce');
        }, 500);
    </script>
