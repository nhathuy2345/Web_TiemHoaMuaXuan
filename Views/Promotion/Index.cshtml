@model List<Web_TiemHoaMuaXuan.Models.Entities.Product>
@{
    ViewBag.Title = "Khuyến mãi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-5 mb-4 rounded-3 text-white shadow-sm"
     style="background: linear-gradient(135deg, #9CB584 0%, #7E9D68 100%);">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold mb-2">🔥 Ưu đãi cực sốc</h1>
        <p class="fs-5 mb-3">Giảm giá lên đến 50% cho các sản phẩm hot.</p>
        <div class="d-flex gap-4 small">
            <span><i class="fa-solid fa-check-circle me-1"></i> Miễn phí ship đơn > 500k</span>
            <span><i class="fa-solid fa-check-circle me-1"></i> Tặng thiệp miễn phí</span>
        </div>
    </div>
</div>

<!-- 3. DANH SÁCH SẢN PHẨM GIẢM GIÁ (Đã fix chia cột) -->
<div class="d-flex justify-content-between align-items-end mb-3 border-bottom pb-2">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-tags text-danger"></i> Sản phẩm đang giảm giá</h4>
        <span class="text-muted small">Tìm thấy @Model.Count sản phẩm ưu đãi</span>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning text-center">Hiện tại chưa có sản phẩm khuyến mãi nào.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="position-relative">
                        <a href="@Url.Action("Details","Product", new { id = p.Id })">
                            <img src="@p.ImageUrl" class="card-img-top" style="height: 220px; object-fit: cover;" alt="@p.Name" onerror="this.src='https://via.placeholder.com/300x220?text=Image'">
                        </a>
                        @if (p.DiscountPercent > 0)
                        {
                            <span class="position-absolute top-0 start-0 bg-danger text-white small px-2 py-1 m-2 rounded fw-bold">
                                -@p.DiscountPercent%
                            </span>
                        }
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title fw-bold text-truncate mb-2" title="@p.Name">
                            <a href="@Url.Action("Details","Product", new { id = p.Id })" class="text-dark text-decoration-none">@p.Name</a>
                        </h6>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-danger fw-bold fs-5">@p.Price.ToString("N0")đ</span>
                                @if (p.OldPrice.HasValue && p.OldPrice > p.Price)
                                {
                                    <small class="text-muted text-decoration-line-through d-block">@p.OldPrice.Value.ToString("N0")đ</small>
                                }
                            </div>
                            <a href="@Url.Action("AddToCart","Cart", new { id = p.Id })" class="btn btn-outline-success btn-sm rounded-circle">
                                <i class="fa-solid fa-cart-plus"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}