@{
    ViewBag.Title = "Liên hệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-7xl mx-auto">
    <!-- Banner -->
    <div class="bg-gradient-to-r from-rose-200 to-pink-100 rounded-2xl p-8 mb-8 text-center">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Liên hệ với chúng tôi</h1>
        <p class="text-gray-600">Chúng tôi luôn sẵn sàng lắng nghe bạn</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- Địa chỉ -->
        <div class="bg-white p-6 rounded-xl shadow-sm text-center">
            <div class="w-14 h-14 mx-auto bg-rose-100 rounded-full flex items-center justify-center mb-4">
                <i class="fa-solid fa-location-dot text-rose-500 text-xl"></i>
            </div>
            <h3 class="font-bold mb-2">Địa chỉ</h3>
            <p class="text-sm text-gray-600">123 Nguyễn Huệ, Quận 1<br>TP. Hồ Chí Minh</p>
        </div>

        <!-- Điện thoại -->
        <div class="bg-white p-6 rounded-xl shadow-sm text-center">
            <div class="w-14 h-14 mx-auto bg-rose-100 rounded-full flex items-center justify-center mb-4">
                <i class="fa-solid fa-phone text-rose-500 text-xl"></i>
            </div>
            <h3 class="font-bold mb-2">Điện thoại</h3>
            <p class="text-sm text-gray-600">Hotline: 0123 456 789<br>Thứ 2 - CN: 8h - 22h</p>
        </div>

        <!-- Email -->
        <div class="bg-white p-6 rounded-xl shadow-sm text-center">
            <div class="w-14 h-14 mx-auto bg-rose-100 rounded-full flex items-center justify-center mb-4">
                <i class="fa-solid fa-envelope text-rose-500 text-xl"></i>
            </div>
            <h3 class="font-bold mb-2">Email</h3>
            <p class="text-sm text-gray-600">contact@tiemhoa.vn<br>support@tiemhoa.vn</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Form liên hệ -->
        <div class="bg-white p-8 rounded-xl shadow-sm">
            <h2 class="text-xl font-bold mb-6">Gửi tin nhắn cho chúng tôi</h2>

            @if (TempData["Success"] != null)
            {
                <div class="bg-green-50 text-green-700 p-3 rounded-lg mb-4 text-sm">
                    <i class="fa-solid fa-check-circle mr-2"></i>@TempData["Success"]
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="bg-red-50 text-red-600 p-3 rounded-lg mb-4 text-sm">
                    @ViewBag.Error
                </div>
            }

            <form method="post" action="@Url.Action("Index","Contact")">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="block mb-1 font-medium">Họ tên *</label>
                    <input type="text" name="name" required
                           placeholder="Nguyễn Văn A"
                           class="w-full border rounded-lg px-3 py-2 focus:border-rose-500 outline-none">
                </div>

                <div class="mb-4">
                    <label class="block mb-1 font-medium">Email *</label>
                    <input type="email" name="email" required
                           placeholder="example@gmail.com"
                           class="w-full border rounded-lg px-3 py-2 focus:border-rose-500 outline-none">
                </div>

                <div class="mb-4">
                    <label class="block mb-1 font-medium">Số điện thoại</label>
                    <input type="tel" name="phone"
                           placeholder="0901234567"
                           class="w-full border rounded-lg px-3 py-2 focus:border-rose-500 outline-none">
                </div>

                <div class="mb-6">
                    <label class="block mb-1 font-medium">Nội dung *</label>
                    <textarea name="message" required rows="5"
                              placeholder="Nội dung bạn muốn liên hệ..."
                              class="w-full border rounded-lg px-3 py-2 focus:border-rose-500 outline-none"></textarea>
                </div>

                <button type="submit"
                        class="w-full bg-rose-500 text-white py-3 rounded-lg hover:bg-rose-600 font-medium">
                    <i class="fa-solid fa-paper-plane mr-2"></i>Gửi tin nhắn
                </button>
            </form>
        </div>

        <!-- Bản đồ + Giờ làm việc -->
        <div>
            <!-- Bản đồ -->
            <div class="bg-white p-4 rounded-xl shadow-sm mb-6">
                <h2 class="font-bold mb-3">Bản đồ</h2>
                <div class="rounded-lg overflow-hidden">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.4991338984785!2d106.7001!3d10.7769!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTDCsDQ2JzM2LjgiTiAxMDbCsDQyJzAwLjQiRQ!5e0!3m2!1svi!2svn!4v1234567890"
                            width="100%" height="300" style="border:0;" allowfullscreen loading="lazy">
                    </iframe>
                </div>
            </div>

            <!-- Giờ làm việc -->
            <div class="bg-white p-6 rounded-xl shadow-sm">
                <h2 class="font-bold mb-3">Giờ làm việc</h2>
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-600">Thứ 2 - Thứ 6</span>
                        <span class="font-medium">8:00 - 22:00</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Thứ 7</span>
                        <span class="font-medium">8:00 - 23:00</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Chủ nhật</span>
                        <span class="font-medium">8:00 - 22:00</span>
                    </div>
                    <div class="flex justify-between text-rose-600">
                        <span>Ngày lễ</span>
                        <span class="font-medium">9:00 - 21:00</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>