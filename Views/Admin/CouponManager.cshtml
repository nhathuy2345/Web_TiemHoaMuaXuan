@model List<Web_TiemHoaMuaXuan.Models.Entities.Coupon>
@{
    ViewBag.Title = "Quản lý Voucher";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row g-4">
    <!-- CỘT TRÁI: FORM THÊM VOUCHER -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold py-3">
                <i class="fa-solid fa-plus-circle text-success me-2"></i>Thêm mã Voucher mới
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {<div class="alert alert-danger">@TempData["Error"]</div>}
                @if (TempData["Success"] != null)
                {<div class="alert alert-success">@TempData["Success"]</div>}

            <form method="post" action="@Url.Action("CreateCoupon", "Admin")">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Mã Code <span class="text-danger">*</span></label>
                    <!-- Bỏ required đi, giữ nguyên name="code" -->
                    <input type="text" name="code" class="form-control text-uppercase" placeholder="VD: SPRING20">
                    <!-- Thêm dòng này để hiện lỗi đỏ -->
                    @Html.ValidationMessage("code", "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Số tiền giảm (VNĐ) <span class="text-danger">*</span></label>
                    <input type="number" name="discountAmount" class="form-control" value="20000">
                    @Html.ValidationMessage("discountAmount", "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Đơn tối thiểu (VNĐ) <span class="text-danger">*</span></label>
                    <input type="number" name="minOrderValue" class="form-control" value="200000">
                    @Html.ValidationMessage("minOrderValue", "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Ngày hết hạn <span class="text-danger">*</span></label>
                    <input type="date" name="expiryDate" class="form-control">
                    @Html.ValidationMessage("expiryDate", "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <button type="submit" class="btn btn-success w-100 fw-bold">
                    <i class="fa-solid fa-save me-2"></i>Lưu mã Voucher
                </button>
            </form>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: DANH SÁCH VOUCHER -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold py-3">
                <i class="fa-solid fa-ticket text-success me-2"></i>Danh sách Voucher (@Model.Count)
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mã Code</th>
                                <th>Giảm giá</th>
                                <th>Đơn tối thiểu</th>
                                <th>HSD</th>
                                <th class="text-end pe-3">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Chưa có mã giảm giá nào.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-success fs-5">@item.Code</td>
                                        <td class="text-danger fw-bold">-@item.DiscountAmount.ToString("N0")đ</td>
                                        <td>@item.MinOrderValue.ToString("N0")đ</td>
                                        <td>@item.ExpiryDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end pe-3">
                                            <!-- ⭐ CHÚ Ý: Nút Xóa truyền 'code' thay vì 'id' -->
                                            <form method="post" action="@Url.Action("DeleteCoupon", "Admin", new { code = item.Code })"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa mã @item.Code?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>