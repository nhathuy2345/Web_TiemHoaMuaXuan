@model Web_TiemHoaMuaXuan.Models.Entities.AppUser
@{
    ViewBag.Title = "Chỉnh sửa khách hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-success"><i class="fa-solid fa-user-pen me-2"></i>Chỉnh sửa thông tin</h5>
                <a href="@Url.Action("UserDetail", "Admin", new { id = Model.Id })" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại
                </a>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm("EditUser", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)

                    <!-- Email không cho sửa (Readonly) -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Email đăng nhập (Không thể thay đổi)</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-light", @readonly = "readonly" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ tên <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại</label>
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Địa chỉ giao hàng</label>
                        @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = "3" })
                    </div>

                    <button type="submit" class="btn btn-success w-100 fw-bold py-2">
                        <i class="fa-solid fa-save me-2"></i> Lưu thay đổi
                    </button>
                }
            </div>
        </div>
    </div>
</div>