@model List<Web_TiemHoaMuaXuan.Models.Entities.Order>
@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">Danh sách đơn hàng (@Model.Count)</h5>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>SĐT</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        string statusBadge = o.Status == "Đã giao" ? "bg-success"
                            : o.Status == "Đang giao hàng" ? "bg-primary"
                            : o.Status == "Đã hủy" ? "bg-danger" : "bg-warning text-dark";

                        <tr>
                            <td class="ps-4 fw-bold text-success">#@o.OrderCode</td>
                            <td>@o.FullName</td>
                            <td>@o.Phone</td>
                            <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-danger">@o.TotalAmount.ToString("N0")đ</td>
                            <td><span class="badge @statusBadge">@o.Status</span></td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("OrderDetail", "Admin", new { id = o.Id })" class="btn btn-sm btn-outline-secondary" title="Xem chi tiết">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>