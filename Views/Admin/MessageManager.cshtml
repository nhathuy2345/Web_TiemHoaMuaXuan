@model System.Collections.Generic.List<Web_TiemHoaMuaXuan.Models.Entities.ContactMessage>
@{
    ViewBag.Title = "Tin nhắn liên hệ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int unreadCount = Model.Count(m => !m.IsRead);
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Danh sách tin nhắn</h5>
        @if (unreadCount > 0)
        {
            <span class="badge bg-danger">@unreadCount tin chưa đọc</span>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success m-3">
            <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Người gửi</th>
                        <th>SĐT</th>
                        <th>Nội dung</th>
                        <th>Ngày gửi</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có tin nhắn nào.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var m in Model)
                        {
                            <tr class="@(!m.IsRead ? "table-warning" : "")">
                                <td class="ps-4 fw-bold">@m.Id</td>
                                <td>
                                    <div class="fw-bold">@m.Name</div>
                                    <div class="small text-muted">@m.Email</div>
                                </td>
                                <td>@m.Phone</td>
                                <td>
                                    <div class="text-truncate" style="max-width: 250px;">@m.Message</div>
                                    @if (!m.IsRead)
                                    {
                                        <span class="badge bg-danger" style="font-size: 0.7rem;">Mới</span>
                                    }
                                </td>
                                <td class="text-muted small">@m.SentAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("MessageDetail", "Admin", new { id = m.Id })" class="btn btn-sm btn-outline-primary" title="Xem">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <form method="post" action="@Url.Action("DeleteMessage", "Admin", new { id = m.Id })" class="d-inline" onsubmit="return confirm('Xóa tin nhắn này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>