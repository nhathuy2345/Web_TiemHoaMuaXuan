@model System.Collections.Generic.List<Web_TiemHoaMuaXuan.Models.Entities.ContactMessage>
@{
    ViewBag.Title = "Tin nhắn liên hệ";
}

<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold">Tin nhắn liên hệ</h1>
            <p class="text-sm text-gray-500 mt-1">
                Tổng cộng @Model.Count tin nhắn
                @{
                    int unread = Model.Count(m => !m.IsRead);
                }
                @if (unread > 0)
                {
                    <span class="bg-red-500 text-white px-2 py-0.5 rounded-full text-xs ml-2">
                        @unread chưa đọc
                    </span>
                }
            </p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 text-green-700 p-3 rounded-lg mb-4 text-sm">
            <i class="fa-solid fa-check-circle mr-2"></i>@TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="bg-white p-10 rounded-xl shadow-sm text-center">
            <i class="fa-solid fa-envelope-open text-5xl text-gray-300 mb-4"></i>
            <p class="text-gray-500">Chưa có tin nhắn nào</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <table class="w-full text-left text-sm">
                <thead class="bg-rose-50 text-gray-700">
                    <tr>
                        <th class="p-3">ID</th>
                        <th class="p-3">Người gửi</th>
                        <th class="p-3">SĐT</th>
                        <th class="p-3">Nội dung</th>
                        <th class="p-3">Ngày gửi</th>
                        <th class="p-3 text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr class="border-t hover:bg-gray-50 @(!m.IsRead ? "bg-yellow-50" : "")">
                            <td class="p-3 font-medium">#@m.Id</td>
                            <td class="p-3">
                                <div class="font-medium">@m.Name</div>
                                <div class="text-xs text-gray-500">@m.Email</div>
                            </td>
                            <td class="p-3">@m.Phone</td>
                            <td class="p-3">
                                <div class="max-w-xs truncate">@m.Message</div>
                                @if (!m.IsRead)
                                {
                                    <span class="text-xs bg-red-500 text-white px-1.5 py-0.5 rounded">
                                        Mới
                                    </span>
                                }
                            </td>
                            <td class="p-3 text-gray-500">
                                @m.SentAt.ToString("dd/MM HH:mm")
                            </td>
                            <td class="p-3 text-right">
                                <a href="@Url.Action("MessageDetail","Admin", new { id = m.Id })"
                                   class="text-blue-500 hover:text-blue-700 mr-3" title="Xem chi tiết">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <button type="button"
                                        onclick="confirmDeleteMessage(@m.Id, '@m.Name')"
                                        class="text-red-500 hover:text-red-700" title="Xóa">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<form id="deleteMsgForm" method="post" action="@Url.Action("DeleteMessage", "Admin")" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteMsgId" />
</form>

@section scripts {
    <script>
        function confirmDeleteMessage(id, name) {
            if (confirm('Xóa tin nhắn từ "' + name + '"?')) {
                document.getElementById('deleteMsgId').value = id;
                document.getElementById('deleteMsgForm').submit();
            }
        }
    </script>
}