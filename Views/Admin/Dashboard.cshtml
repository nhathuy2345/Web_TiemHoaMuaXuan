@{
    ViewBag.Title = "Dashboard";
}

<div class="max-w-7xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Trang quản trị</h1>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white p-5 rounded-xl shadow-sm">
            <div class="flex justify-between items-center mb-2">
                <span class="text-gray-500 text-sm">Sản phẩm</span>
                <i class="fa-solid fa-box text-rose-500"></i>
            </div>
            <div class="text-2xl font-bold">@ViewBag.TotalProducts</div>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm">
            <div class="flex justify-between items-center mb-2">
                <span class="text-gray-500 text-sm">Danh mục</span>
                <i class="fa-solid fa-tags text-blue-500"></i>
            </div>
            <div class="text-2xl font-bold">@ViewBag.TotalCategories</div>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm">
            <div class="flex justify-between items-center mb-2">
                <span class="text-gray-500 text-sm">Đơn hàng</span>
                <i class="fa-solid fa-receipt text-green-500"></i>
            </div>
            <div class="text-2xl font-bold">@ViewBag.TotalOrders</div>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm">
            <div class="flex justify-between items-center mb-2">
                <span class="text-gray-500 text-sm">Doanh thu</span>
                <i class="fa-solid fa-dollar-sign text-yellow-500"></i>
            </div>
            <div class="text-2xl font-bold">@(((decimal)ViewBag.Revenue).ToString("N0"))đ</div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="@Url.Action("ProductManager","Admin")" class="block p-6 bg-white rounded-xl shadow-sm hover:shadow-md transition">
            <i class="fa-solid fa-box text-3xl text-rose-500 mb-3"></i>
            <h3 class="font-bold mb-1">Quản lý sản phẩm</h3>
            <p class="text-sm text-gray-500">Thêm, sửa, xóa sản phẩm</p>
        </a>
        <a href="@Url.Action("OrderManager","Admin")" class="block p-6 bg-white rounded-xl shadow-sm hover:shadow-md transition">
            <i class="fa-solid fa-receipt text-3xl text-rose-500 mb-3"></i>
            <h3 class="font-bold mb-1">Quản lý đơn hàng</h3>
            <p class="text-sm text-gray-500">Xem đơn hàng</p>
        </a>
    </div>
</div>