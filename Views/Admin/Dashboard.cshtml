@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // ⭐ Ép kiểu ViewBag để lấy dữ liệu chuẩn xác
    var bestSellers = ViewBag.BestSellers as List<Web_TiemHoaMuaXuan.Models.Entities.ProductStatItem>;
    var worstSellers = ViewBag.WorstSellers as List<Web_TiemHoaMuaXuan.Models.Entities.ProductStatItem>;
}

<!-- Các thẻ thống kê -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card bg-success text-white h-100 p-3 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1 text-white-50">Sản phẩm</h6>
                    <h2 class="mb-0 fw-bold">@ViewBag.TotalProducts</h2>
                </div>
                <i class="fa-solid fa-box fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card bg-primary text-white h-100 p-3 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1 text-white-50">Danh mục</h6>
                    <h2 class="mb-0 fw-bold">@ViewBag.TotalCategories</h2>
                </div>
                <i class="fa-solid fa-tags fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card bg-warning text-dark h-100 p-3 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1 text-dark-50">Đơn hàng</h6>
                    <h2 class="mb-0 fw-bold">@ViewBag.TotalOrders</h2>
                </div>
                <i class="fa-solid fa-receipt fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card bg-danger text-white h-100 p-3 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-1 text-white-50">Doanh thu</h6>
                    <h2 class="mb-0 fw-bold">@(((decimal)ViewBag.Revenue).ToString("N0"))đ</h2>
                </div>
                <i class="fa-solid fa-dollar-sign fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Khối Thống kê Bán chạy / Bán ế -->
<div class="row g-4 mt-2">
    <!-- Cột Bán Chạy Nhất -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                <i class="fa-solid fa-fire text-danger fs-5 me-2"></i>
                <h5 class="mb-0 fw-bold text-danger">Top 5 Sản phẩm bán chạy</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Sản phẩm</th>
                                <th class="text-center">Giá bán</th>
                                <th class="text-center pe-4">Đã bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (bestSellers != null && bestSellers.Count > 0)
                            {
                                foreach (var item in bestSellers)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ImageUrl" class="rounded me-3 border" style="width: 45px; height: 45px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/45'">
                                                <span class="fw-bold text-dark text-truncate" style="max-width: 200px;" title="@item.Name">@item.Name</span>
                                            </div>
                                        </td>
                                        <td class="text-center text-muted">@item.Price.ToString("N0")đ</td>
                                        <td class="text-center pe-4">
                                            <span class="badge bg-success fs-6 rounded-pill">@item.TotalSold</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center py-4 text-muted">Chưa có dữ liệu bán hàng.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột Bán Ế Nhất -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                <i class="fa-solid fa-snowflake text-primary fs-5 me-2"></i>
                <h5 class="mb-0 fw-bold text-primary">Top 5 Sản phẩm bán ế</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Sản phẩm</th>
                                <th class="text-center">Giá bán</th>
                                <th class="text-center pe-4">Đã bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (worstSellers != null && worstSellers.Count > 0)
                            {
                                foreach (var item in worstSellers)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ImageUrl" class="rounded me-3 border" style="width: 45px; height: 45px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/45'">
                                                <span class="fw-bold text-dark text-truncate" style="max-width: 200px;" title="@item.Name">@item.Name</span>
                                            </div>
                                        </td>
                                        <td class="text-center text-muted">@item.Price.ToString("N0")đ</td>
                                        <td class="text-center pe-4">
                                            @if (item.TotalSold == 0)
                                            {
                                                <span class="badge bg-secondary fs-6 rounded-pill">Chưa bán được</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark fs-6 rounded-pill">@item.TotalSold</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center py-4 text-muted">Chưa có dữ liệu.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>