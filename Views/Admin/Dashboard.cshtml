@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var bestSellers = ViewBag.BestSellers as List<Web_TiemHoaMuaXuan.Models.Entities.ProductStatItem>;
    var worstSellers = ViewBag.WorstSellers as List<Web_TiemHoaMuaXuan.Models.Entities.ProductStatItem>;
}

<style>
    .kpi-card {
        background: #ffffff;
        border: 1px solid #EAE6DC;
        border-radius: 16px;
        padding: 22px 24px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 4px 16px rgba(44, 51, 41, 0.03);
    }

        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(44, 51, 41, 0.07);
        }

    .kpi-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #788273;
        margin-bottom: 6px;
    }

    .kpi-value {
        font-size: 26px;
        font-weight: 700;
        color: #2C3329;
        font-variant-numeric: tabular-nums;
        margin: 0;
    }

    .kpi-icon-box {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .icon-sage {
        background-color: #EEF3EA;
        color: #5F7D4B;
    }

    .icon-blue {
        background-color: #EBF3FA;
        color: #3B76A8;
    }

    .icon-amber {
        background-color: #FDF5E6;
        color: #C28228;
    }

    .icon-rose {
        background-color: #FCEEEF;
        color: #C24D57;
    }

    .dashboard-panel {
        background: #ffffff;
        border: 1px solid #EAE6DC;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(44, 51, 41, 0.03);
        overflow: hidden;
    }

    .panel-header {
        padding: 18px 24px;
        border-bottom: 1px solid #F0EDE5;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .panel-title {
        font-size: 16px;
        font-weight: 700;
        color: #2C3329;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-custom th {
        background-color: #FAF8F3;
        color: #788273;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #EAE6DC;
        padding: 12px 16px;
    }

    .table-custom td {
        padding: 13px 16px;
        border-bottom: 1px solid #F4F1EA;
        vertical-align: middle;
    }

    .table-custom tr:last-child td {
        border-bottom: none;
    }

    .badge-sold {
        background-color: #EEF3EA;
        color: #4A6838;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 13px;
    }

    .badge-unsold {
        background-color: #F3F2EE;
        color: #788273;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
    }

    .badge-low {
        background-color: #FDF5E6;
        color: #B4731B;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 13px;
    }
</style>

<!-- 1. HÀNG THẺ KPI TỔNG QUAN -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card h-100 d-flex justify-content-between align-items-center">
            <div>
                <div class="kpi-label">Sản phẩm</div>
                <h2 class="kpi-value">@ViewBag.TotalProducts</h2>
            </div>
            <div class="kpi-icon-box icon-sage">
                <i class="fa-solid fa-seedling"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card h-100 d-flex justify-content-between align-items-center">
            <div>
                <div class="kpi-label">Danh mục hoa</div>
                <h2 class="kpi-value">@ViewBag.TotalCategories</h2>
            </div>
            <div class="kpi-icon-box icon-blue">
                <i class="fa-solid fa-tags"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card h-100 d-flex justify-content-between align-items-center">
            <div>
                <div class="kpi-label">Tổng đơn hàng</div>
                <h2 class="kpi-value">@ViewBag.TotalOrders</h2>
            </div>
            <div class="kpi-icon-box icon-amber">
                <i class="fa-solid fa-receipt"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card h-100 d-flex justify-content-between align-items-center">
            <div>
                <div class="kpi-label">Tổng doanh thu</div>
                <h2 class="kpi-value text-success" style="color: #5F7D4B !important;">@(((decimal)ViewBag.Revenue).ToString("N0"))đ</h2>
            </div>
            <div class="kpi-icon-box icon-rose">
                <i class="fa-solid fa-coins"></i>
            </div>
        </div>
    </div>
</div>

<!-- 2. HÀNG BIỂU ĐỒ TRỰC QUAN (CHART.JS) -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="dashboard-panel h-100">
            <div class="panel-header">
                <h5 class="panel-title">
                    <span class="kpi-icon-box icon-sage" style="width: 34px; height: 34px; font-size: 14px; border-radius: 9px;">
                        <i class="fa-solid fa-chart-line"></i>
                    </span>
                    Biểu đồ doanh thu 7 ngày gần nhất
                </h5>
                <span class="badge rounded-pill" style="background-color: #EEF3EA; color: #5F7D4B; font-weight: 600;">Dữ liệu thực tế</span>
            </div>
            <div class="p-4">
                <div style="height: 260px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="dashboard-panel h-100">
            <div class="panel-header">
                <h5 class="panel-title">
                    <span class="kpi-icon-box icon-amber" style="width: 34px; height: 34px; font-size: 14px; border-radius: 9px;">
                        <i class="fa-solid fa-chart-pie"></i>
                    </span>
                    Tỷ lệ đơn hàng
                </h5>
            </div>
            <div class="p-4 d-flex align-items-center justify-content-center">
                <div style="height: 260px; width: 100%;">
                    <canvas id="orderStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3. HÀNG THỐNG KÊ TOP SẢN PHẨM -->
<div class="row g-4">
    <!-- Cột Bán Chạy Nhất -->
    <div class="col-lg-6">
        <div class="dashboard-panel h-100">
            <div class="panel-header">
                <h5 class="panel-title">
                    <span class="kpi-icon-box icon-rose" style="width: 34px; height: 34px; font-size: 14px; border-radius: 9px;">
                        <i class="fa-solid fa-fire"></i>
                    </span>
                    Top 5 Sản phẩm bán chạy
                </h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Sản phẩm</th>
                            <th class="text-center">Giá bán</th>
                            <th class="text-center pe-4">Đã bán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (bestSellers != null && bestSellers.Count > 0)
                        {
                            foreach (var item in bestSellers)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <img src="@item.ImageUrl" class="rounded-3 me-3 border" style="width: 46px; height: 46px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/46'">
                                            <span class="fw-semibold text-dark text-truncate" style="max-width: 210px;" title="@item.Name">@item.Name</span>
                                        </div>
                                    </td>
                                    <td class="text-center text-muted" style="font-variant-numeric: tabular-nums;">@item.Price.ToString("N0")đ</td>
                                    <td class="text-center pe-4">
                                        <span class="badge-sold">@item.TotalSold</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center py-4 text-muted">Chưa có sản phẩm nào phát sinh lượt bán.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Cột Bán Ế Nhất -->
    <div class="col-lg-6">
        <div class="dashboard-panel h-100">
            <div class="panel-header">
                <h5 class="panel-title">
                    <span class="kpi-icon-box icon-blue" style="width: 34px; height: 34px; font-size: 14px; border-radius: 9px;">
                        <i class="fa-solid fa-snowflake"></i>
                    </span>
                    Top 5 Sản phẩm bán chậm
                </h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Sản phẩm</th>
                            <th class="text-center">Giá bán</th>
                            <th class="text-center pe-4">Đã bán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (worstSellers != null && worstSellers.Count > 0)
                        {
                            foreach (var item in worstSellers)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <img src="@item.ImageUrl" class="rounded-3 me-3 border" style="width: 46px; height: 46px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/46'">
                                            <span class="fw-semibold text-dark text-truncate" style="max-width: 210px;" title="@item.Name">@item.Name</span>
                                        </div>
                                    </td>
                                    <td class="text-center text-muted" style="font-variant-numeric: tabular-nums;">@item.Price.ToString("N0")đ</td>
                                    <td class="text-center pe-4">
                                        @if (item.TotalSold == 0)
                                        {
                                            <span class="badge-unsold">Chưa bán được</span>
                                        }
                                        else
                                        {
                                            <span class="badge-low">@item.TotalSold</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center py-4 text-muted">Chưa có dữ liệu.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 1. Biểu đồ doanh thu 7 ngày
        const labels = @Html.Raw(ViewBag.ChartLabelsJson ?? "[]");
        const revenues = @Html.Raw(ViewBag.ChartRevenuesJson ?? "[]");

        const ctxRev = document.getElementById('revenueChart').getContext('2d');
        const gradientRev = ctxRev.createLinearGradient(0, 0, 0, 260);
        gradientRev.addColorStop(0, 'rgba(126, 157, 104, 0.35)');
        gradientRev.addColorStop(1, 'rgba(126, 157, 104, 0.0)');

        new Chart(ctxRev, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: revenues,
                    borderColor: '#5F7D4B',
                    backgroundColor: gradientRev,
                    borderWidth: 2.5,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#5F7D4B',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#2C3329',
                        padding: 12,
                        callbacks: {
                            label: function (ctx) {
                                return ' ' + Number(ctx.raw).toLocaleString('vi-VN') + 'đ';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#788273', font: { family: 'Inter' } }
                    },
                    y: {
                        beginAtZero: true,
                        border: { display: false },
                        grid: { color: '#F0EDE5' },
                        ticks: {
                            color: '#788273',
                            font: { family: 'Inter' },
                            callback: function (val) {
                                return val >= 1000000 ? (val / 1000000) + 'tr' : val.toLocaleString('vi-VN');
                            }
                        }
                    }
                }
            }
        });

        // 2. Biểu đồ tròn trạng thái đơn hàng
        const orderStats = @Html.Raw(ViewBag.OrderStatusJson ?? "[0,0,0,0]");
        const ctxStatus = document.getElementById('orderStatusChart').getContext('2d');

        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: ['Đã giao', 'Đang xử lý / Giao', 'Chờ xử lý', 'Đã hủy'],
                datasets: [{
                    data: orderStats,
                    backgroundColor: ['#7E9D68', '#5B9BD5', '#E5A93C', '#D96B6B'],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 16,
                            usePointStyle: true,
                            pointStyle: 'circle',
                            color: '#4F584B',
                            font: { family: 'Inter', size: 12 }
                        }
                    }
                }
            }
        });
    </script>
}