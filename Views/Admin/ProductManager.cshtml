@model List<Web_TiemHoaMuaXuan.Models.Entities.Product>
@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold">Danh sách sản phẩm (@Model.Count)</h5>
        <a href="@Url.Action("CreateProduct", "Admin")" class="btn btn-success btn-sm">
            <i class="fa-solid fa-plus me-1"></i> Thêm sản phẩm
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success m-3">
            <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá bán</th>
                        <th>Tồn kho</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="ps-4">@p.Id</td>
                            <td>
                                <img src="@p.ImageUrl" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/50'">
                            </td>
                            <td class="fw-bold">@p.Name</td>
                            <td class="text-danger fw-bold">@p.Price.ToString("N0")đ</td>
                            <td>@p.Stock</td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("EditProduct", "Admin", new { id = p.Id })" class="btn btn-sm btn-outline-primary" title="Sửa">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form method="post" action="@Url.Action("DeleteProduct", "Admin", new { id = p.Id })" class="d-inline" onsubmit="return confirm('Xóa sản phẩm @p.Name?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>