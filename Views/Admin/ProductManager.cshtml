@model System.Collections.Generic.List<Web_TiemHoaMuaXuan.Models.Entities.Product>
@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold">Quản lý sản phẩm</h1>
            <p class="text-sm text-gray-500 mt-1">Tổng cộng @Model.Count sản phẩm</p>
        </div>
        <a href="@Url.Action("CreateProduct", "Admin")"
           class="bg-rose-500 text-white px-5 py-2.5 rounded-lg hover:bg-rose-600 font-medium shadow-sm">
            <i class="fa-solid fa-plus mr-2"></i>Thêm sản phẩm
        </a>
    </div>

    <!-- Thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 text-green-700 p-3 rounded-lg mb-4 text-sm">
            <i class="fa-solid fa-check-circle mr-2"></i>@TempData["Success"]
        </div>
    }

    <!-- Bảng SP -->
    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
        <table class="w-full text-left text-sm">
            <thead class="bg-rose-50 text-gray-700">
                <tr>
                    <th class="p-3">ID</th>
                    <th class="p-3">Ảnh</th>
                    <th class="p-3">Tên sản phẩm</th>
                    <th class="p-3">Giá</th>
                    <th class="p-3">Tồn kho</th>
                    <th class="p-3 text-right">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="border-t hover:bg-gray-50">
                        <td class="p-3 font-medium">@p.Id</td>
                        <td class="p-3">
                            <img src="@p.ImageUrl" class="w-14 h-14 object-cover rounded-lg">
                        </td>
                        <td class="p-3">
                            <div class="font-medium">@p.Name</div>
                            @if (p.DiscountPercent > 0)
                            {
                                <span class="text-xs bg-red-100 text-red-600 px-1.5 py-0.5 rounded">
                                    -@p.DiscountPercent%
                                </span>
                            }
                        </td>
                        <td class="p-3 text-rose-600 font-bold">@p.Price.ToString("N0")đ</td>
                        <td class="p-3">
                            <span class="@(p.Stock > 10 ? "text-green-600" : "text-red-500")">
                                @p.Stock
                            </span>
                        </td>
                        <td class="p-3 text-right">
                            <a href="@Url.Action("EditProduct", "Admin", new { id = p.Id })"
                               class="inline-block text-blue-500 hover:text-blue-700 mr-3"
                               title="Sửa">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <button type="button"
                                    onclick="confirmDelete(@p.Id, '@p.Name')"
                                    class="text-red-500 hover:text-red-700"
                                    title="Xóa">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Form ẩn để xóa (POST) -->
<form id="deleteForm" method="post" action="@Url.Action("DeleteProduct", "Admin")" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
</form>

@section scripts {
    <script>
        function confirmDelete(id, name) {
            if (confirm('Bạn có chắc muốn xóa sản phẩm "' + name + '" không?')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}