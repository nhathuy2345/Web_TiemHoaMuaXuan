@model System.Collections.Generic.List<Web_TiemHoaMuaXuan.Models.Entities.Product>
@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-7xl mx-auto">
    <h1 class="text-2xl font-bold mb-6">Quản lý sản phẩm (@Model.Count)</h1>

    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
        <table class="w-full text-left text-sm">
            <thead class="bg-rose-50 text-gray-700">
                <tr>
                    <th class="p-3">ID</th>
                    <th class="p-3">Ảnh</th>
                    <th class="p-3">Tên</th>
                    <th class="p-3">Giá</th>
                    <th class="p-3">Tồn</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="border-t hover:bg-gray-50">
                        <td class="p-3">@p.Id</td>
                        <td class="p-3"><img src="@p.ImageUrl" class="w-12 h-12 object-cover rounded"></td>
                        <td class="p-3 font-medium">@p.Name</td>
                        <td class="p-3 text-rose-600 font-bold">@p.Price.ToString("N0")đ</td>
                        <td class="p-3">@p.Stock</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>