@model List<Web_TiemHoaMuaXuan.Models.Entities.Product>
@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
        <h5 class="mb-0 fw-bold text-success"><i class="fa-solid fa-box me-2"></i>Danh sách sản phẩm (@Model.Count)</h5>
        <a href="@Url.Action("CreateProduct", "Admin")" class="btn btn-success btn-sm px-3 fw-bold">
            <i class="fa-solid fa-plus me-1"></i> Thêm sản phẩm
        </a>
    </div>

    <!-- ⭐ ĐÃ XÓA ĐOẠN HIỂN THỊ TEMPDATA Ở ĐÂY ĐỂ TRÁNH BỊ LẶP 2 LẦN ⭐ -->

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá bán</th>
                        <th>Tồn kho</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có sản phẩm nào.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-4">@p.Id</td>
                                <td>
                                    <img src="@p.ImageUrl" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/50'">
                                </td>
                                <td class="fw-bold">@p.Name</td>
                                <td class="text-danger fw-bold">@p.Price.ToString("N0")đ</td>
                                <td>
                                    @if (p.Stock > 0)
                                    {
                                        <span class="badge bg-success">@p.Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Hết hàng</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("EditProduct", "Admin", new { id = p.Id })" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <form method="post" action="@Url.Action("DeleteProduct", "Admin", new { id = p.Id })" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm @p.Name?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>