@model IEnumerable<Web_TiemHoaMuaXuan.Models.Entities.Category>
@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold text-success"><i class="fa-solid fa-tags me-2"></i>Danh sách danh mục (@Model.Count())</h5>
        <a href="@Url.Action("CreateCategory", "Admin")" class="btn btn-success">
            <i class="fa-solid fa-plus me-1"></i> Thêm danh mục
        </a>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {<div class="alert alert-success m-3">@TempData["Success"]</div>}
        @if (TempData["Error"] != null)
        {<div class="alert alert-danger m-3">@TempData["Error"]</div>}

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">@item.Id</td>
                            <td class="fw-bold text-success">@item.Name</td>
                            <td class="text-muted">@item.Description</td>
                            <td>
                                @if (item.IsActive)
                                {<span class="badge bg-success">Hoạt động</span> }
                                else
                                { <span class="badge bg-secondary">Đã ẩn</span>}
                            </td>
                            <td class="text-end pe-4">
                                <a href="@Url.Action("EditCategory", "Admin", new { id = item.Id })" class="btn btn-sm btn-outline-primary" title="Sửa">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form method="post" action="@Url.Action("DeleteCategory", "Admin", new { id = item.Id })" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục @item.Name?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>