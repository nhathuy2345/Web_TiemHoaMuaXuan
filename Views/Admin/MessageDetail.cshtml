@model Web_TiemHoaMuaXuan.Models.Entities.ContactMessage
@{
    ViewBag.Title = "Chi tiết tin nhắn";
}

<div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <a href="@Url.Action("MessageManager", "Admin")"
           class="text-sm text-gray-500 hover:text-rose-500">
            <i class="fa-solid fa-arrow-left mr-1"></i>Quay lại danh sách
        </a>
        <h1 class="text-2xl font-bold mt-2">Tin nhắn #@Model.Id</h1>
    </div>

    <!-- Thông tin người gửi -->
    <div class="bg-white rounded-xl shadow-sm p-6 mb-4">
        <h2 class="font-bold mb-4">Người gửi</h2>
        <div class="grid grid-cols-2 gap-4 text-sm">
            <div>
                <span class="text-gray-500">Họ tên:</span>
                <p class="font-medium">@Model.Name</p>
            </div>
            <div>
                <span class="text-gray-500">Email:</span>
                <p class="font-medium">
                    <a href="mailto:@Model.Email" class="text-blue-500 hover:underline">@Model.Email</a>
                </p>
            </div>
            <div>
                <span class="text-gray-500">SĐT:</span>
                <p class="font-medium">
                    <a href="tel:@Model.Phone" class="text-blue-500 hover:underline">@Model.Phone</a>
                </p>
            </div>
            <div>
                <span class="text-gray-500">Ngày gửi:</span>
                <p class="font-medium">@Model.SentAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>
    </div>

    <!-- Nội dung -->
    <div class="bg-white rounded-xl shadow-sm p-6 mb-4">
        <h2 class="font-bold mb-3">Nội dung tin nhắn</h2>
        <div class="bg-gray-50 p-4 rounded-lg text-gray-700 leading-relaxed whitespace-pre-wrap">
            @Model.Message
        </div>
    </div>

    <!-- Hành động -->
    <div class="flex gap-3">
        <a href="@Url.Action("MessageManager", "Admin")"
           class="flex-1 text-center px-6 py-3 border rounded-lg hover:bg-gray-50 font-medium">
            Quay lại
        </a>
        <a href="mailto:@Model.Email?subject=Re: Liên hệ từ Tiệm Hoa Mùa Xuân"
           class="flex-1 text-center px-6 py-3 bg-rose-500 text-white rounded-lg hover:bg-rose-600 font-medium">
            <i class="fa-solid fa-reply mr-2"></i>Trả lời qua Email
        </a>
    </div>
</div>