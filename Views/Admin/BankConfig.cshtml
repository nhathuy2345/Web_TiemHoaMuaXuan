@model Web_TiemHoaMuaXuan.Models.Entities.BankSetting
@{
    ViewBag.Title = "Cấu hình ngân hàng";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6">
        <h1 class="text-2xl font-bold">Cấu hình ngân hàng</h1>
        <p class="text-sm text-gray-500 mt-1">
            Thông tin này hiển thị trên QR thanh toán
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 text-green-700 p-3 rounded-lg mb-4 text-sm">
            <i class="fa-solid fa-check-circle mr-2"></i>@TempData["Success"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="bg-red-50 text-red-600 p-3 rounded-lg mb-4 text-sm">
            @ViewBag.Error
        </div>
    }

    <form method="post" action="@Url.Action("BankConfig","Admin")"
          class="bg-white rounded-xl shadow-sm p-6">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label class="block mb-1 font-medium">Tên ngân hàng *</label>
            <input type="text" name="BankName" required value="@Model.BankName"
                   placeholder="VD: Vietcombank"
                   class="w-full border rounded-lg px-3 py-2 focus:border-rose-500 outline-none">
        </div>

        <div class="mb-4">
            <label class="block mb-1 font-medium">Số tài khoản *</label>
            <input type="text" name="AccountNumber" required value="@Model.AccountNumber"
                   placeholder="VD: 0123456789"
                   class="w-full border rounded-lg px-3 py-2 focus:border-rose-500 outline-none">
        </div>

        <div class="mb-4">
            <label class="block mb-1 font-medium">Chủ tài khoản</label>
            <input type="text" name="AccountHolder" value="@Model.AccountHolder"
                   placeholder="VD: NGUYEN VAN A"
                   class="w-full border rounded-lg px-3 py-2 focus:border-rose-500 outline-none">
            <p class="text-xs text-gray-400 mt-1">Tên không dấu, viết hoa</p>
        </div>

        <div class="mb-6">
            <label class="block mb-1 font-medium">URL ảnh QR (tùy chọn)</label>
            <input type="text" name="QRImageUrl" value="@Model.QRImageUrl"
                   placeholder="Để trống sẽ tự sinh QR"
                   class="w-full border rounded-lg px-3 py-2 focus:border-rose-500 outline-none">
        </div>

        <button type="submit"
                class="w-full bg-rose-500 text-white py-3 rounded-lg hover:bg-rose-600 font-medium">
            <i class="fa-solid fa-save mr-2"></i>Lưu cấu hình
        </button>
    </form>
</div>