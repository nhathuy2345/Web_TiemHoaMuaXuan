@model Web_TiemHoaMuaXuan.Models.Entities.BankSetting
@{
    ViewBag.Title = "Cấu hình ngân hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Cấu hình thông tin thanh toán QR</h5>
            </div>
            <div class="card-body p-4">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
                    </div>
                }
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form method="post" action="@Url.Action("BankConfig", "Admin")">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên ngân hàng <span class="text-danger">*</span></label>
                        <input type="text" name="BankName" class="form-control" value="@Model.BankName" required placeholder="VD: Vietcombank">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số tài khoản <span class="text-danger">*</span></label>
                        <input type="text" name="AccountNumber" class="form-control" value="@Model.AccountNumber" required placeholder="VD: 0123456789">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Chủ tài khoản</label>
                        <input type="text" name="AccountHolder" class="form-control" value="@Model.AccountHolder" placeholder="VD: NGUYEN VAN A">
                        <div class="form-text">Tên không dấu, viết hoa.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">URL ảnh QR (Tùy chọn)</label>
                        <input type="text" name="QRImageUrl" class="form-control" value="@Model.QRImageUrl" placeholder="https://...">
                        <div class="form-text">Nếu để trống, hệ thống sẽ tự sinh mã QR từ thông tin trên.</div>
                    </div>

                    <button type="submit" class="btn btn-success px-4">
                        <i class="fa-solid fa-save me-2"></i>Lưu cấu hình
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>