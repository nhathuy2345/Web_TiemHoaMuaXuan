@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-sm mt-10">
    <h2 class="text-2xl font-bold text-center mb-6 text-rose-600">Đăng nhập</h2>

    @if (ViewBag.Error != null)
    {
        <div class="bg-red-50 text-red-600 p-3 rounded mb-4 text-sm">@ViewBag.Error</div>
    }

    <form method="post" action="@Url.Action("Login","Account")">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label class="block mb-1 font-medium">Email</label>
            <input type="email" name="email" required
                   class="w-full border rounded px-3 py-2 focus:border-rose-500 outline-none"
                   placeholder="example@gmail.com">
        </div>

        <div class="mb-6">
            <label class="block mb-1 font-medium">Mật khẩu</label>
            <input type="password" name="password" required
                   class="w-full border rounded px-3 py-2 focus:border-rose-500 outline-none"
                   placeholder="Nhập mật khẩu">
        </div>

        <button type="submit"
                class="w-full bg-rose-500 text-white py-2 rounded hover:bg-rose-600 font-medium">
            Đăng nhập
        </button>
    </form>

    <p class="text-center mt-4 text-sm">
        Chưa có tài khoản?
        <a href="@Url.Action("Register","Account")"
           class="text-rose-500 font-medium hover:underline">Đăng ký ngay</a>
    </p>

    <p class="text-center mt-3 text-xs text-gray-400">
        Gợi ý: dùng email có chữ "admin" để vào trang quản trị
    </p>
</div>

