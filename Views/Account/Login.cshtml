@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <i class="fa-solid fa-leaf text-success fs-1 mb-2"></i>
                        <h3 class="fw-bold text-success">Đăng nhập</h3>
                        <p class="text-muted small">Chào mừng bạn trở lại Tiệm Hoa Mùa Xuân</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center small">
                            <i class="fa-solid fa-circle-exclamation me-1"></i>@ViewBag.Error
                        </div>
                    }

                    <form method="post" action="@Url.Action("Login","Account")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <div class="mb-3">
                            <label class="form-label fw-medium">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-envelope"></i></span>
                                <input type="email" name="email" class="form-control" required placeholder="example@gmail.com">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-lock"></i></span>
                                <input type="password" name="password" class="form-control" required placeholder="Nhập mật khẩu">
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                            Đăng nhập
                        </button>
                    </form>

                    <div class="text-center mt-4 small">
                        <span class="text-muted">Chưa có tài khoản?</span>
                        <a href="@Url.Action("Register","Account")" class="text-success fw-bold text-decoration-none">Đăng ký ngay</a>
                    </div>
                    @*
                    <div class="text-center mt-3">
                        <small class="text-muted fst-italic"><i class="fa-solid fa-circle-info"></i> Gợi ý: Dùng email có chữ "admin" để vào trang quản trị.</small>
                    </div>
                        *@
                </div>
            </div>
        </div>
    </div>
</div>