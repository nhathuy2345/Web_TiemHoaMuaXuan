@model Web_TiemHoaMuaXuan.Models.Entities.AppUser
@{
    ViewBag.Title = "Chỉnh sửa thông tin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h3 class="fw-bold text-success">Chỉnh sửa thông tin</h3>
                        <p class="text-muted small">Cập nhật thông tin cá nhân của bạn</p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <form method="post" action="@Url.Action("EditProfile","Account")">
                        @Html.AntiForgeryToken()

                        <!-- Email không cho sửa -->
                        <div class="mb-3">
                            <label class="form-label fw-medium">Email (Không thể thay đổi)</label>
                            <input type="email" class="form-control bg-light" value="@Model.Email" readonly>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Họ tên <span class="text-danger">*</span></label>
                            <input type="text" name="fullName" value="@Model.FullName" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Số điện thoại</label>
                            <input type="tel" name="phone" value="@Model.Phone" class="form-control" placeholder="VD: 0901234567">
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">Địa chỉ</label>
                            <textarea name="address" class="form-control" rows="3" placeholder="Số nhà, đường, quận...">@Model.Address</textarea>
                        </div>

                        <div class="d-flex gap-3">
                            <a href="@Url.Action("Profile", "Account")" class="btn btn-outline-secondary w-50">Hủy</a>
                            <button type="submit" class="btn btn-success w-50 fw-bold">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>