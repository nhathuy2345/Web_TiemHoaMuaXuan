@{
    ViewBag.Title = "Hồ sơ cá nhân - Tiệm Hoa Mùa Xuân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row">
        <!-- Thông tin cá nhân -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 text-center" style="background-color: #ffffff;">
                <div class="mb-3">
                    <img src="https://via.placeholder.com/120" class="rounded-circle border p-1" width="120" height="120" alt="Avatar">
                </div>
                <h5 class="fw-bold text-success mb-1">@ViewBag.FullName</h5>
                <p class="text-muted small">Khách hàng thân thiết</p>

                <ul class="list-group list-group-flush text-start mt-3">
                    <li class="list-group-item border-0 px-0"><strong>Email:</strong> @ViewBag.Email</li>
                    <li class="list-group-item border-0 px-0"><strong>SĐT:</strong> @ViewBag.Phone</li>
                    <li class="list-group-item border-0 px-0"><strong>Địa chỉ:</strong> @ViewBag.Address</li>
                </ul>
            </div>
        </div>

        <!-- Lịch sử đơn hàng -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 p-4" style="background-color: #ffffff;">
                <h4 class="fw-bold mb-4" style="color: #2e7d32;">LỊCH SỬ ĐƠN HÀNG</h4>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Ngày đặt</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold">#DH1001</td>
                                <td>09/10/2026</td>
                                <td class="text-success fw-bold">450.000 đ</td>
                                <td><span class="badge bg-success">Đã giao</span></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">#DH1002</td>
                                <td>05/10/2026</td>
                                <td class="text-success fw-bold">780.000 đ</td>
                                <td><span class="badge bg-warning text-dark">Đang giao</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>