@model Web_TiemHoaMuaXuan.Models.Entities.AppUser
@using System.Collections.Generic
@using Web_TiemHoaMuaXuan.Models.Entities

@{
    ViewBag.Title = "Hồ sơ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var orders = ViewBag.Orders as List<Order> ?? new List<Order>();
}

<div class="max-w-3xl mx-auto">
    <!-- Thông tin cá nhân -->
    <div class="bg-white p-8 rounded-xl shadow-sm mb-6">
        <div class="flex items-center gap-4 mb-6">
            <div class="w-16 h-16 rounded-full bg-rose-500 text-white flex items-center justify-center text-2xl font-bold">
                @(Model.FullName != null && Model.FullName.Length > 0
                    ? Model.FullName[0].ToString().ToUpper()
                    : "U")
            </div>
            <div>
                <h2 class="text-2xl font-bold">@Model.FullName</h2>
                <p class="text-gray-500 text-sm">@Model.Email</p>
            </div>
        </div>

        <div class="border-t pt-4">
            <div class="grid grid-cols-2 gap-4 text-sm">
                <div>
                    <span class="text-gray-500">Email:</span>
                    <p class="font-medium">@Model.Email</p>
                </div>
                <div>
                    <span class="text-gray-500">Số điện thoại:</span>
                    <p class="font-medium">@(Model.Phone ?? "Chưa cập nhật")</p>
                </div>
            </div>
        </div>

        <div class="mt-6 flex gap-4">
            <a href="@Url.Action("EditProfile","Account")"
               class="text-blue-500 hover:underline text-sm">
                <i class="fa-solid fa-user-pen mr-1"></i>Cập nhật thông tin
            </a>
            <a href="@Url.Action("Logout","Account")"
               class="text-red-500 hover:underline text-sm">
                <i class="fa-solid fa-right-from-bracket mr-1"></i>Đăng xuất
            </a>
        </div>
    </div>

    <!-- Lịch sử đơn hàng -->
    <div class="bg-white p-8 rounded-xl shadow-sm">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold">Lịch sử đơn hàng</h3>
            <span class="text-sm text-gray-500">@orders.Count đơn</span>
        </div>

        @if (orders.Count == 0)
        {
            <div class="text-center py-8 text-gray-400">
                <i class="fa-solid fa-receipt text-4xl mb-3"></i>
                <p>Chưa có đơn hàng nào</p>
                <a href="@Url.Action("Index","Product")"
                   class="inline-block mt-4 text-rose-500 hover:underline text-sm">
                    Mua sắm ngay →
                </a>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var order in orders)
                {
                    <div class="border rounded-lg p-4 hover:shadow-sm transition">
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <span class="font-bold text-rose-600">#@order.OrderCode</span>
                                <span class="text-xs text-gray-500 ml-2">
                                    @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>
                            @{
                                string statusClass = "";
                                switch (order.Status)
                                {
                                    case "Chờ xử lý": statusClass = "bg-yellow-100 text-yellow-700"; break;
                                    case "Đã xác nhận": statusClass = "bg-blue-100 text-blue-700"; break;
                                    case "Đang giao hàng": statusClass = "bg-purple-100 text-purple-700"; break;
                                    case "Đã giao": statusClass = "bg-green-100 text-green-700"; break;
                                    case "Đã hủy": statusClass = "bg-red-100 text-red-700"; break;
                                    default: statusClass = "bg-gray-100 text-gray-700"; break;
                                }
                            }
                            <span class="px-2 py-1 rounded-full text-xs font-medium @statusClass">
                                @order.Status
                            </span>
                        </div>

                        <!-- List SP trong đơn -->
                        <div class="space-y-2">
                            @foreach (var item in order.Items)
                            {
                                <div class="flex items-center gap-2 text-sm">
                                    <img src="@item.Image" class="w-10 h-10 object-cover rounded">
                                    <span class="flex-1 truncate">@item.ProductName</span>
                                    <span class="text-gray-500">×@item.Quantity</span>
                                </div>
                            }
                        </div>

                        <div class="mt-3 pt-3 border-t flex justify-between items-center">
                            <span class="text-sm text-gray-500">
                                @order.PaymentMethod
                            </span>
                            <span class="font-bold text-rose-600">
                                @order.TotalAmount.ToString("N0")đ
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>