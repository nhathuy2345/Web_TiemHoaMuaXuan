@model Web_TiemHoaMuaXuan.Models.Entities.AppUser
@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var orders = ViewBag.Orders as System.Collections.Generic.List<Web_TiemHoaMuaXuan.Models.Entities.Order>
                 ?? new System.Collections.Generic.List<Web_TiemHoaMuaXuan.Models.Entities.Order>();
}

<div class="container py-4">

    <!-- Thanh Breadcrumb (Giống Dalat Hasfarm) -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")" class="text-warning text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thông tin tài khoản</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- CỘT TRÁI: MENU TÀI KHOẢN -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm mb-4">
                <!-- Avatar & Tên -->
                <div class="card-body text-center border-bottom py-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-3 fw-bold"
                         style="width: 70px; height: 70px; font-size: 1.8rem;">
                        @(Model.FullName != null && Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "U")
                    </div>
                    <h6 class="fw-bold mb-0 text-dark">@Model.FullName</h6>
                </div>

                <!-- Menu điều hướng -->
                <div class="list-group list-group-flush fs-6">
                    <!-- Tab 1 -->
                    <a href="#info-tab" data-bs-toggle="tab" class="list-group-item list-group-item-action active fw-bold">
                        <i class="fa-solid fa-circle-user me-2"></i> Thông tin tài khoản
                    </a>

                    <!-- Tab 2 -->
                    <a href="#orders-tab" data-bs-toggle="tab" class="list-group-item list-group-item-action">
                        <i class="fa-solid fa-box me-2"></i> Đơn hàng của tôi
                    </a>

                    <!-- Nút đăng xuất -->
                    <a href="@Url.Action("Logout","Account")" class="list-group-item list-group-item-action text-danger">
                        <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: NỘI DUNG THAY ĐỔI -->
        <div class="col-lg-9">
            <div class="tab-content">

                <!-- TAB 1: THÔNG TIN TÀI KHOẢN -->
                <div class="tab-pane fade show active" id="info-tab">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h5 class="fw-bold text-success mb-0"><i class="fa-solid fa-circle-info me-2"></i>Thông tin tài khoản</h5>
                        </div>
                        <div class="card-body p-4">

                            <!-- Dòng Họ Tên -->
                            <div class="row border-bottom py-3">
                                <div class="col-sm-4 text-muted fw-medium">Họ tên</div>
                                <div class="col-sm-8 fw-bold text-dark">@Model.FullName</div>
                            </div>

                            <!-- Dòng Email -->
                            <div class="row border-bottom py-3">
                                <div class="col-sm-4 text-muted fw-medium">Email</div>
                                <div class="col-sm-8 text-dark">@Model.Email</div>
                            </div>

                            <!-- Dòng Số điện thoại -->
                            <div class="row border-bottom py-3">
                                <div class="col-sm-4 text-muted fw-medium">Số điện thoại</div>
                                <div class="col-sm-8 text-dark">@(string.IsNullOrEmpty(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</div>
                            </div>

                            <!-- Dòng Địa chỉ -->
                            <div class="row py-3">
                                <div class="col-sm-4 text-muted fw-medium">Địa chỉ</div>
                                <div class="col-sm-8 text-dark">@(string.IsNullOrEmpty(Model.Address) ? "Chưa cập nhật" : Model.Address)</div>
                            </div>

                            <div class="mt-4 pt-3 border-top text-end">
                                <a href="@Url.Action("EditProfile", "Account")" class="btn btn-outline-success btn-sm">
                                    <i class="fa-solid fa-pen me-1"></i> Chỉnh sửa thông tin
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: LỊCH SỬ ĐƠN HÀNG -->
                <div class="tab-pane fade" id="orders-tab">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-success mb-0"><i class="fa-solid fa-receipt me-2"></i>Lịch sử đơn hàng</h5>
                            <span class="badge bg-secondary">@orders.Count đơn</span>
                        </div>
                        <div class="card-body p-0">
                            @if (orders.Count == 0)
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-box-open fs-1 mb-3 text-secondary"></i>
                                    <p>Bạn chưa có đơn hàng nào.</p>
                                    <a href="@Url.Action("Index","Product")" class="btn btn-success btn-sm">Mua sắm ngay</a>
                                </div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var order in orders)
                                    {
                                        string statusBadge = order.Status == "Đã giao" ? "bg-success"
                                            : order.Status == "Đang giao hàng" ? "bg-primary"
                                            : order.Status == "Đã hủy" ? "bg-danger" : "bg-warning text-dark";

                                        <div class="list-group-item p-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <span class="fw-bold text-danger fs-5">#@order.OrderCode</span>
                                                    <span class="text-muted small ms-2">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                                <span class="badge @statusBadge">@order.Status</span>
                                            </div>

                                            <!-- Danh sách SP trong đơn -->
                                            <div class="bg-light rounded p-3 mb-3">
                                                @foreach (var item in order.Items)
                                                {
                                                    <div class="d-flex align-items-center gap-3 mb-2">
                                                        <img src="@item.Image" class="rounded" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/40'">
                                                        <div class="flex-grow-1 small text-truncate">@item.ProductName</div>
                                                        <div class="small text-muted">x@item.Quantity</div>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Tổng tiền & Nút Hủy -->
                                            <div class="d-flex justify-content-between align-items-center mt-2">
                                                <span class="small text-muted">Thanh toán: @order.PaymentMethod</span>

                                                <div class="d-flex align-items-center gap-3">
                                                    <span class="fw-bold text-danger fs-5">@order.TotalAmount.ToString("N0")đ</span>

                                                    <!-- ⭐ NÚT HỦY ĐƠN HÀNG (Chỉ hiện khi đơn đang Chờ xử lý) ⭐ -->
                                                    @if (order.Status == "Chờ xử lý")
                                                    {
                                                        <form method="post" action="@Url.Action("CancelOrder", "Account", new { id = order.Id })"
                                                              class="m-0"
                                                              onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng #@order.OrderCode không?');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-outline-danger btn-sm fw-bold">
                                                                <i class="fa-solid fa-xmark"></i> Hủy đơn
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </div>

                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>