@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-sm mt-10">
    <h2 class="text-2xl font-bold text-center mb-6 text-rose-600">Đăng ký tài khoản</h2>

    @if (ViewBag.Error != null)
    {
        <div class="bg-red-50 text-red-600 p-3 rounded mb-4 text-sm">@ViewBag.Error</div>
    }

    <form method="post" action="@Url.Action("Register","Account")">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label class="block mb-1 font-medium">Họ tên</label>
            <input type="text" name="fullName" required
                   class="w-full border rounded px-3 py-2 focus:border-rose-500 outline-none"
                   placeholder="Nguyễn Văn A">
        </div>

        <div class="mb-4">
            <label class="block mb-1 font-medium">Email</label>
            <input type="email" name="email" required
                   class="w-full border rounded px-3 py-2 focus:border-rose-500 outline-none"
                   placeholder="example@gmail.com">
        </div>

        <div class="mb-4">
            <label class="block mb-1 font-medium">Số điện thoại</label>
            <input type="tel" name="phone"
                   class="w-full border rounded px-3 py-2 focus:border-rose-500 outline-none"
                   placeholder="0123456789">
        </div>

        <div class="mb-4">
            <label class="block mb-1 font-medium">Mật khẩu</label>
            <input type="password" name="password" required minlength="6"
                   class="w-full border rounded px-3 py-2 focus:border-rose-500 outline-none"
                   placeholder="Tối thiểu 6 ký tự">
        </div>

        <div class="mb-6">
            <label class="block mb-1 font-medium">Xác nhận mật khẩu</label>
            <input type="password" name="confirmPassword" required
                   class="w-full border rounded px-3 py-2 focus:border-rose-500 outline-none"
                   placeholder="Nhập lại mật khẩu">
        </div>

        <button type="submit"
                class="w-full bg-rose-500 text-white py-2 rounded hover:bg-rose-600 font-medium">
            Đăng ký
        </button>
    </form>

    <p class="text-center mt-4 text-sm">
        Đã có tài khoản?
        <a href="@Url.Action("Login","Account")"
           class="text-rose-500 font-medium hover:underline">Đăng nhập</a>
    </p>
</div>
@{
    ViewBag.Title = "Đăng ký - Tiệm Hoa Mùa Xuân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .register-card {
        background-color: white;
        border: none;
        border-radius: 16px;
    }

    .register-title {
        color: #2e7d32;
    }

    .register-btn {
        background-color: #4caf50;
        color: white;
        border: none;
    }

        .register-btn:hover {
            background-color: #388e3c;
            color: white;
        }

    .register-card .form-control {
        border-radius: 8px;
        padding: 10px 12px;
    }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card register-card shadow p-4">

                <h3 class="text-center fw-bold mb-2 register-title">
                    ĐĂNG KÝ TÀI KHOẢN
                </h3>

                <p class="text-center text-muted mb-4">
                    Tạo tài khoản để mua sắm tại Tiệm Hoa Mùa Xuân
                </p>

                <form action="@Url.Action("Register", "Account")"
                      method="post" id="registerForm">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="fullname" class="form-label">
                            Họ và tên
                        </label>

                        <input type="text" id="fullname" name="fullname"
                               class="form-control"
                               placeholder="Nguyễn Văn A" required>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">
                            Địa chỉ Email
                        </label>

                        <input type="email" id="email" name="email"
                               class="form-control"
                               placeholder="example@gmail.com" required>
                    </div>

                    <div class="mb-3">
                        <label for="phone" class="form-label">
                            Số điện thoại
                        </label>

                        <input type="tel" id="phone" name="phone"
                               class="form-control"
                               pattern="[0-9]{10}"
                               placeholder="0901234567" required>

                        <small class="text-muted">
                            Số điện thoại gồm 10 chữ số.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">
                            Mật khẩu
                        </label>

                        <input type="password" id="password" name="password"
                               class="form-control"
                               minlength="6"
                               placeholder="Tối thiểu 6 ký tự" required>
                    </div>

                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">
                            Xác nhận mật khẩu
                        </label>

                        <input type="password" id="confirmPassword"
                               class="form-control"
                               placeholder="Nhập lại mật khẩu" required>

                        <div class="text-danger small mt-1"
                             id="confirmError" style="display: none;">
                            Mật khẩu xác nhận không trùng khớp!
                        </div>
                    </div>

                    <button type="submit"
                            class="btn register-btn w-100 py-2 fw-bold mt-2">
                        Đăng Ký
                    </button>

                </form>

                <hr class="my-4">

                <p class="text-center mb-0">
                    <span class="text-muted">Đã có tài khoản?</span>
                    <a href="@Url.Action("Login", "Account")"
                       class="text-success fw-bold text-decoration-none">
                        Đăng nhập
                    </a>
                </p>

            </div>

        </div>
    </div>
</div>

<script>
    const form = document.getElementById("registerForm");
    const password = document.getElementById("password");
    const confirmPassword = document.getElementById("confirmPassword");
    const confirmError = document.getElementById("confirmError");

    form.addEventListener("submit", function (e) {
        if (password.value !== confirmPassword.value) {
            e.preventDefault();
            confirmError.style.display = "block";
        } else {
            confirmError.style.display = "none";
        }
    });

    confirmPassword.addEventListener("input", function () {
        confirmError.style.display = "none";
    });
</script>
