@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h3 class="fw-bold text-success">Đăng ký tài khoản</h3>
                        <p class="text-muted small">Trở thành thành viên của SpringFlower</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center small">@ViewBag.Error</div>
                    }

                    <form method="post" action="@Url.Action("Register","Account")">
                        @Html.AntiForgeryToken()

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Họ tên <span class="text-danger">*</span></label>
                                <input type="text" name="fullName" class="form-control" required placeholder="Nguyễn Văn A">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Số điện thoại</label>
                                <input type="tel" name="phone" class="form-control" placeholder="0901234567">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Email <span class="text-danger">*</span></label>
                            <input type="email" name="email" class="form-control" required placeholder="example@gmail.com">
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Mật khẩu <span class="text-danger">*</span></label>
                                <input type="password" name="password" class="form-control" required minlength="6" placeholder="Tối thiểu 6 ký tự">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                                <input type="password" name="confirmPassword" class="form-control" required placeholder="Nhập lại mật khẩu">
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                            Tạo tài khoản
                        </button>
                    </form>

                    <div class="text-center mt-4 small">
                        <span class="text-muted">Đã có tài khoản?</span>
                        <a href="@Url.Action("Login","Account")" class="text-success fw-bold text-decoration-none">Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>