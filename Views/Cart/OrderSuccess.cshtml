@model Web_TiemHoaMuaXuan.Models.Entities.Order
@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">

            <div class="mb-4">
                <i class="fa-solid fa-circle-check text-success" style="font-size: 5rem;"></i>
            </div>
            <h2 class="fw-bold text-success mb-2">Đặt hàng thành công!</h2>
            <p class="text-muted fs-5 mb-4">Cảm ơn bạn đã mua hoa tại SpringFlower.</p>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                        <span class="fw-bold fs-5">Mã đơn hàng:</span>
                        <span class="fw-bold fs-5 text-danger">#@Model.OrderCode</span>
                    </div>

                    <div class="text-start row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Người nhận:</span>
                            <span class="fw-bold">@Model.FullName - @Model.Phone</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Thanh toán:</span>
                            <span class="fw-bold">@(Model.PaymentMethod == "COD" ? "Thanh toán khi nhận hàng" : "Chuyển khoản")</span>
                        </div>
                        <div class="col-12">
                            <span class="text-muted small d-block">Địa chỉ:</span>
                            <span class="fw-bold">@Model.Address</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-center">
                <a href="@Url.Action("Index","Product")" class="btn btn-outline-success px-4 py-2">
                    <i class="fa-solid fa-bag-shopping me-2"></i>Tiếp tục mua sắm
                </a>
                <a href="@Url.Action("Profile","Account")" class="btn btn-success px-4 py-2">
                    <i class="fa-solid fa-receipt me-2"></i>Xem lịch sử đơn
                </a>
            </div>
        </div>
    </div>
</div>