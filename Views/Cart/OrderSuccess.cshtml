@model Web_TiemHoaMuaXuan.Models.Entities.Order
@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">

            <div class="mb-4">
                <i class="fa-solid fa-circle-check text-success" style="font-size: 5rem;"></i>
            </div>
            <h2 class="fw-bold text-success mb-2">Đặt hàng thành công!</h2>
            <p class="text-muted fs-5 mb-4">Cảm ơn bạn đã mua hoa tại SpringFlower.</p>

            <!-- ⭐ KHỐI HIỂN THỊ QR ĐỘNG TỪ SEPAY ⭐ -->
            @if (ViewBag.QrUrl != null)
            {
                <div class="card border-0 shadow-sm mb-4 bg-light">
                    <div class="card-body p-4 text-center">
                        <h5 class="fw-bold text-success mb-3">Quét mã để hoàn tất thanh toán</h5>

                        <!-- Ảnh QR lấy từ ViewBag.QrUrl do Controller truyền sang -->
                        <img src="@ViewBag.QrUrl" alt="QR Code" style="max-width: 250px; border-radius: 10px;" class="shadow-sm border" />

                        <p class="mt-3 mb-1 fw-bold text-danger">Số tiền: @Model.TotalAmount.ToString("N0")đ</p>
                        <p class="text-muted small">Nội dung CK: Thanh toan don hang @Model.OrderCode</p>

                        <!-- Dòng trạng thái sẽ được AJAX cập nhật -->
                        <div id="payment-status" class="mt-3 text-primary fw-bold fs-5">
                            <i class="fa-solid fa-spinner fa-spin"></i> Đang chờ nhận tiền...
                        </div>
                    </div>
                </div>
            }

            <!-- KHỐI THÔNG TIN ĐƠN HÀNG -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                        <span class="fw-bold fs-5">Mã đơn hàng:</span>
                        <span class="fw-bold fs-5 text-danger">#@Model.OrderCode</span>
                    </div>

                    <div class="text-start row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Người nhận:</span>
                            <span class="fw-bold">@Model.FullName - @Model.Phone</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Thanh toán:</span>
                            <span class="fw-bold">@(Model.PaymentMethod == "COD" ? "Thanh toán khi nhận hàng" : "Chuyển khoản")</span>
                        </div>
                        <div class="col-12">
                            <span class="text-muted small d-block">Địa chỉ:</span>
                            <span class="fw-bold">@Model.Address</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- NÚT ĐIỀU HƯỚNG -->
            <div class="d-flex gap-3 justify-content-center">
                <a href="@Url.Action("Index","Product")" class="btn btn-outline-success px-4 py-2">
                    <i class="fa-solid fa-bag-shopping me-2"></i>Tiếp tục mua sắm
                </a>
                <a href="@Url.Action("Profile","Account")" class="btn btn-success px-4 py-2">
                    <i class="fa-solid fa-receipt me-2"></i>Xem lịch sử đơn
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ⭐ SCRIPT TỰ ĐỘNG KIỂM TRA TRẠNG THÁI THANH TOÁN ⭐ -->
@section scripts {
    @if (ViewBag.QrUrl != null)
    {
        <script>
            $(document).ready(function () {
                var orderCode = '@Model.OrderCode';

                function checkStatus() {
                    $.ajax({
                        url: '/Cart/CheckPaymentStatus',
                        type: 'GET',
                        data: { orderCode: orderCode },
                        success: function (res) {
                            if (res.status === 'paid') {
                                $('#payment-status').html('<span class="text-success"><i class="fa-solid fa-check-circle"></i> Thanh toán thành công! Hệ thống đã ghi nhận.</span>');
                                setTimeout(function(){ location.reload(); }, 1500);
                            } else {
                                setTimeout(checkStatus, 3000);
                            }
                        },
                        error: function() {
                            setTimeout(checkStatus, 5000);
                        }
                    });
                }
                setTimeout(checkStatus, 3000);
            });
        </script>
    }
}