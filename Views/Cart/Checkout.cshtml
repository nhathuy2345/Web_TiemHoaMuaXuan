@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userFullName = ViewBag.UserFullName as string ?? "";
    var userPhone = ViewBag.UserPhone as string ?? "";
    var userAddress = ViewBag.UserAddress as string ?? "";
    decimal totalAmount = (decimal)(ViewBag.TotalAmount ?? 0m);
}

<div class="max-w-2xl mx-auto bg-white p-8 rounded-xl shadow-sm">
    <h2 class="text-2xl font-bold mb-6 text-rose-600">
        <i class="fa-solid fa-truck mr-2"></i>Thông tin giao hàng
    </h2>

    <!-- Tổng tiền -->
    <div class="bg-rose-50 p-4 rounded-lg mb-6 flex justify-between items-center">
        <span class="font-medium">Tổng tiền thanh toán:</span>
        <span class="text-2xl font-bold text-rose-600">@totalAmount.ToString("N0")đ</span>
    </div>

    <form method="post" action="@Url.Action("Checkout","Cart")" id="checkoutForm">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label class="block mb-1 font-medium">Họ tên người nhận *</label>
            <input type="text" name="fullName" required value="@userFullName"
                   placeholder="Nguyễn Văn A"
                   class="w-full border rounded-lg px-3 py-2 focus:border-rose-500 outline-none">
        </div>

        <div class="mb-4">
            <label class="block mb-1 font-medium">Số điện thoại *</label>
            <input type="tel" name="phone" required value="@userPhone"
                   placeholder="0901234567"
                   class="w-full border rounded-lg px-3 py-2 focus:border-rose-500 outline-none">
        </div>

        <div class="mb-4">
            <label class="block mb-1 font-medium">Địa chỉ giao hàng *</label>
            <textarea name="address" required rows="3"
                      placeholder="Số nhà, đường, quận, thành phố..."
                      class="w-full border rounded-lg px-3 py-2 focus:border-rose-500 outline-none">@userAddress</textarea>
        </div>

        <div class="mb-6">
            <label class="block mb-2 font-medium">Phương thức thanh toán</label>

            <label class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:border-rose-500 mb-2">
                <input type="radio" name="payment" value="COD" checked>
                <i class="fa-solid fa-money-bill-wave text-rose-500 text-xl"></i>
                <div>
                    <div class="font-medium">Thanh toán khi nhận hàng (COD)</div>
                    <div class="text-xs text-gray-500">Trả tiền mặt khi shipper giao hoa</div>
                </div>
            </label>

            <label class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:border-rose-500">
                <input type="radio" name="payment" value="Bank">
                <i class="fa-solid fa-building-columns text-rose-500 text-xl"></i>
                <div>
                    <div class="font-medium">Chuyển khoản ngân hàng</div>
                    <div class="text-xs text-gray-500">Quét QR để thanh toán nhanh</div>
                </div>
            </label>
        </div>

        <!-- QR SECTION -->
        <div id="qr-section" class="hidden mb-6 p-6 bg-gradient-to-br from-rose-50 to-pink-50 rounded-xl border-2 border-rose-200">
            <div class="text-center mb-4">
                <div class="inline-flex items-center gap-2 bg-rose-500 text-white px-4 py-2 rounded-full text-sm font-bold">
                    <i class="fa-solid fa-qrcode"></i>
                    Quét mã để thanh toán
                </div>
            </div>

            <div class="flex flex-col items-center">
                <div class="bg-white p-4 rounded-xl shadow-md relative">
                    <div id="qrcode"></div>

                    <div id="qr-expired" class="hidden absolute inset-0 bg-white/95 rounded-xl flex flex-col items-center justify-center">
                        <i class="fa-solid fa-clock-rotate-left text-4xl text-red-500 mb-3"></i>
                        <div class="font-bold text-red-500 mb-2">QR đã hết hạn</div>
                        <button type="button" onclick="refreshQR()"
                                class="text-sm bg-rose-500 text-white px-4 py-2 rounded-lg hover:bg-rose-600">
                            <i class="fa-solid fa-rotate-right mr-1"></i>Tạo QR mới
                        </button>
                    </div>
                </div>

                <div class="mt-4 flex items-center gap-2 text-sm">
                    <i class="fa-solid fa-hourglass-half text-rose-500"></i>
                    <span class="text-gray-600">Mã hết hạn sau:</span>
                    <span id="countdown" class="font-bold text-rose-600 text-lg">05:00</span>
                </div>

                <div class="mt-4 w-full max-w-sm text-sm bg-white p-4 rounded-lg border border-rose-100">
                    <div class="flex justify-between py-1 border-b border-dashed">
                        <span class="text-gray-500">Ngân hàng:</span>
                        <span class="font-medium">Techcombank</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-dashed">
                        <span class="text-gray-500">Số TK:</span>
                        <span class="font-medium">10000865070207</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-dashed">
                        <span class="text-gray-500">Chủ TK:</span>
                        <span class="font-medium">TIEM HOA MUA XUAN</span>
                    </div>
                    <div class="flex justify-between py-1">
                        <span class="text-gray-500">Số tiền:</span>
                        <span class="font-medium text-rose-600">@totalAmount.ToString("N0")đ</span>
                    </div>
                </div>

                <div class="mt-3 text-xs text-gray-500 text-center max-w-sm">
                    <i class="fa-solid fa-info-circle mr-1"></i>
                    Vui lòng chuyển đúng số tiền và ghi rõ nội dung. Shop sẽ xác nhận trong 5 phút.
                </div>
            </div>
        </div>

        <div class="flex gap-3">
            <a href="@Url.Action("Index","Cart")"
               class="px-6 py-3 border rounded-lg hover:bg-gray-50 font-medium">
                <i class="fa-solid fa-arrow-left mr-1"></i>Quay lại giỏ
            </a>
            <button type="submit" id="btn-submit"
                    class="flex-1 bg-rose-500 text-white py-3 rounded-lg hover:bg-rose-600 font-medium disabled:opacity-50 disabled:cursor-not-allowed">
                <i class="fa-solid fa-check mr-2"></i>Đặt hàng
            </button>
        </div>
    </form>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
        var countdownTimer = null;
        var timeLeft = 300;

        var bankInfo = "TECHCOMBANK\nSTK: 10000865070207\nCHU TK: TIEM HOA MUA XUAN\nSo tien: @totalAmount\nNoi dung: DH + SDT";

        function generateQR() {
            var container = document.getElementById("qrcode");
            container.innerHTML = "";
            new QRCode(container, {
                text: bankInfo,
                width: 200,
                height: 200,
                colorDark: "#000000",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
        }

        function startCountdown() {
            timeLeft = 300;
            updateCountdownDisplay();
            if (countdownTimer) clearInterval(countdownTimer);
            countdownTimer = setInterval(function () {
                timeLeft--;
                updateCountdownDisplay();
                if (timeLeft <= 0) {
                    clearInterval(countdownTimer);
                    document.getElementById("qr-expired").classList.remove("hidden");
                    document.getElementById("btn-submit").disabled = true;
                }
            }, 1000);
        }

        function updateCountdownDisplay() {
            var m = Math.floor(timeLeft / 60);
            var s = timeLeft % 60;
            var el = document.getElementById("countdown");
            if (el) {
                el.textContent = (m < 10 ? "0" : "") + m + ":" + (s < 10 ? "0" : "") + s;
                el.className = timeLeft <= 60
                    ? "font-bold text-red-600 text-lg animate-pulse"
                    : "font-bold text-rose-600 text-lg";
            }
        }

        function refreshQR() {
            document.getElementById("qr-expired").classList.add("hidden");
            document.getElementById("btn-submit").disabled = false;
            generateQR();
            startCountdown();
        }

        document.querySelectorAll('input[name="payment"]').forEach(function (radio) {
            radio.addEventListener("change", function () {
                if (this.value === "Bank") {
                    document.getElementById("qr-section").classList.remove("hidden");
                    generateQR();
                    startCountdown();
                } else {
                    document.getElementById("qr-section").classList.add("hidden");
                    if (countdownTimer) clearInterval(countdownTimer);
                    document.getElementById("btn-submit").disabled = false;
                }
            });
        });
    </script>
}