@model List<Web_TiemHoaMuaXuan.Models.Entities.CartItem>
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal total = Model.Sum(x => x.TotalPrice);
}

<div class="max-w-7xl mx-auto">
    <h2 class="text-2xl font-bold mb-6">Giỏ hàng của bạn</h2>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 text-green-700 p-3 rounded-lg mb-4 text-sm">
            <i class="fa-solid fa-check-circle mr-2"></i>@TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="bg-white p-10 rounded-xl text-center shadow-sm">
            <i class="fa-solid fa-cart-shopping text-5xl text-gray-300 mb-4"></i>
            <p class="text-gray-500 mb-4">Giỏ hàng đang trống.</p>
            <a href="@Url.Action("Index","Product")"
               class="inline-block bg-rose-500 text-white px-6 py-2 rounded-lg hover:bg-rose-600">
                Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <table class="w-full text-left">
                <thead class="bg-rose-50 text-gray-700">
                    <tr>
                        <th class="p-4">Sản phẩm</th>
                        <th class="p-4">Đơn giá</th>
                        <th class="p-4 text-center">Số lượng</th>
                        <th class="p-4">Thành tiền</th>
                        <th class="p-4"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border-t">
                            <td class="p-4">
                                <div class="flex items-center gap-3">
                                    <img src="@item.Image" class="w-16 h-16 object-cover rounded-lg">
                                    <span class="font-medium">@item.ProductName</span>
                                </div>
                            </td>
                            <td class="p-4 text-gray-600">@item.Price.ToString("N0")đ</td>
                            <td class="p-4">
                                <form method="post" action="@Url.Action("UpdateQuantity","Cart")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ProductId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1"
                                           class="w-16 border rounded px-2 py-1 text-center"
                                           onchange="this.form.submit()" />
                                </form>
                            </td>
                            <td class="p-4 font-bold text-rose-600">@item.TotalPrice.ToString("N0")đ</td>
                            <td class="p-4">
                                <a href="@Url.Action("RemoveItem","Cart", new { id = item.ProductId })"
                                   class="text-red-500 hover:text-red-700">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-gray-50">
                    <tr>
                        <td colspan="3" class="p-4 text-right font-bold">Tổng cộng:</td>
                        <td colspan="2" class="p-4 text-rose-600 font-bold text-xl">@total.ToString("N0")đ</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="flex justify-end mt-6 gap-3">
            <a href="@Url.Action("Index","Product")"
               class="px-6 py-2.5 border rounded-lg hover:bg-gray-50">
                <i class="fa-solid fa-arrow-left mr-1"></i>Tiếp tục mua
            </a>
            <a href="@Url.Action("Checkout","Cart")"
               class="px-6 py-2.5 bg-rose-500 text-white rounded-lg hover:bg-rose-600">
                Thanh toán <i class="fa-solid fa-arrow-right ml-1"></i>
            </a>
        </div>
    }
</div>